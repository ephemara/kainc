pub const DEFAULT_SOURCE_ROOT:  String = "src/"
pub const DEFAULT_DEPS:         String = ""
pub const DEFAULT_OUTPUT:       String = "kainc"
pub const DEFAULT_RUNTIME:      String = "kain_runtime"
pub const DEFAULT_LINKER:       String = "clang"
pub const DEFAULT_LINKER_FLAGS: String = ""
