// ============================================================================
// cli/orchestrator.kn
// ============================================================================
// ============================================================================
//  orchestrator.kn — MarkScript VM embedding for compiler orchestration
//  STREAM: CHARLIE
//  Consumed by: GOLF (as orchestration entry point)
//
//  This file embeds the markscript VM into the self-host compiler. It:
//    1. Creates and configures the markscript VM
//    2. Registers 9 compiler-specific IVT handlers (IDs 200-208)
//    3. Loads build config from markscript tables in build.md
//    4. Executes build pipelines defined in buildex.md
//    5. Provides CLI entry points for GOLF's cli.kn / main.kn
//
//  ALL handlers are STUBS — they return 0 (success) and print diagnostics.
//  GOLF wires them to real compiler functions in Wave 4.
//
//  Ladder rung: Layer 0 (fn) — plain orchestration module.
//  The heavy lifting is done by markscript (embedded VM).
//
//  Markscript API contract: EXACTLY 20 public functions from std::markscript.
//  No internal markscript calls, no direct VM field access.
// ============================================================================

use std::markscript
use std::fs
use std::os
use std::text

// ═════════════════════════════════════════════════════════════════════════════
// BuildConfig — populated from markscript tables in build.md
// ═════════════════════════════════════════════════════════════════════════════

// ═════════════════════════════════════════════════════════════════════════════
// Diagnostics + TestResult — simple types for orchestrator state
// ═════════════════════════════════════════════════════════════════════════════

pub struct Diagnostics:
    errors:   Array<String>
    warnings: Array<String>

pub fn diagnostics_new() -> Diagnostics:
    return Diagnostics {
        errors:   [],
        warnings: [],
    }

pub struct TestResult:
    name:   String
    passed: Bool
    error:  String

// ═════════════════════════════════════════════════════════════════════════════
// IVT Handler ID Constants (200-208)
// ═════════════════════════════════════════════════════════════════════════════

pub const HANDLER_COMPILE_CHECK:   Int = 200
pub const HANDLER_COMPILE_CODEGEN: Int = 201
pub const HANDLER_COMPILE_JIT:     Int = 202
pub const HANDLER_TEST_RUN:        Int = 203
pub const HANDLER_TEST_REPORT:     Int = 204
pub const HANDLER_BUILD_LINK:      Int = 205
pub const HANDLER_BUILD_PACKAGE:   Int = 206
pub const HANDLER_SELFHOST_PHASE1: Int = 207
pub const HANDLER_SELFHOST_PHASE2: Int = 208

// ═════════════════════════════════════════════════════════════════════════════
// SOURCE_ORDER — canonical concatenation order (from KAIN.toml [source_order])
// ═════════════════════════════════════════════════════════════════════════════

pub const SOURCE_ORDER: Array<String> = [
    "core/token.kn",
    "core/error.kn",
    "core/span.kn",
    "core/ast.kn",
    "cli/build.kn",
    "parser/lexer.kn",
    "core/builtins.kn",
    "codegen/runtime.kn",
    "codegen/llvm_ffi.kn",
    "jit/jit_metal.kn",
    "jit/jit_x86.kn",
    "jit/jit_orc.kn",
    "jit/jit_cache.kn",
    "jit/jit.kn",
    "parser/parser.kn",
    "typecheck/types.kn",
    "typecheck/effects.kn",
    "typecheck/monomorphize.kn",
    "codegen/codegen.kn",
    "cli/compiler.kn",
    "cli/orchestrator.kn",
    "cli/cli.kn",
    "cli/main.kn",
]

// ═════════════════════════════════════════════════════════════════════════════
// Forward stubs for compiler.kn types (shadowed at ouroboros combine time)
//
// compiler.kn (source_order position 20) appears BEFORE orchestrator.kn (21)
// in the combined source. These forward stubs allow handlers to reference
// compiler.kn's DriverSession pipeline. At combine time, compiler.kn's real
// implementations take precedence and these stubs are shadowed.
// ═════════════════════════════════════════════════════════════════════════════

// ── Forward stubs for compiler.kn functions (shadowed at combine time) ──

// ═════════════════════════════════════════════════════════════════════════════
// Handler Functions — WIRED to compiler.kn DriverSession (Phase 3+)
//
// These handlers bridge the markscript VM's IVT dispatch to the compiler
// pipeline. Each handler reads source, creates a DriverSession, and calls
// the appropriate compilation phase function.
//
// In standalone mode (before combine), the forward stubs above return
// empty results. At ouroboros combine time, compiler.kn's real
// implementations take precedence and the pipeline works end-to-end.
// ═════════════════════════════════════════════════════════════════════════════

pub fn handler_compile_check(file_path: String) -> Int with IO:
    println("[kainc] compile check: " + file_path)
    let source: String = fs_read_text(file_path)
    if source == "":
        println("[kainc] ERROR: cannot read file: " + file_path)
        return 1
    // Step 2: real frontend — lex + parse + typecheck in-process.
    let session: DriverSession = driver_session_new()
    let result: KcCheckResult = driver_session_check(session, source, file_path)
    if result.success:
        println("[kainc] check OK: " + file_path)
        return 0
    emit_diagnostics_to_stderr(result.diagnostics)
    return 1

pub fn handler_compile_codegen(file_path: String, target: String, profile: String) -> Int with IO:
    println("[kainc] compile codegen: " + file_path + " (target: " + target + ", profile: " + profile + ")")
    let source: String = fs_read_text(file_path)
    if source == "":
        println("[kainc] ERROR: cannot read file: " + file_path)
        return 1
    // Bootstrap: shell out to kain build for real compilation
    let cmd: String = "kain build " + file_path + " --target llvm"
    println("[kainc] invoking: " + cmd)
    let result: Int = os_system(cmd)
    if result != 0:
        println("[kainc] codegen: kain build returned exit code " + str(result))
        return result
    println("[kainc] codegen: SUCCESS")
    return 0

pub fn handler_compile_jit(file_path: String) -> Int with IO:
    println("[kainc] compile jit: " + file_path)
    println("[kainc] JIT compilation deferred (bootstrap passthrough)")
    return 0

pub fn handler_test_run(spec_path: String) -> Int with IO:
    println("[kainc] test run: " + spec_path)
    println("[kainc] test: passthrough (bootstrap mode)")
    return 0

pub fn handler_test_report(spec_root: String, output_path: String) -> String with IO:
    println("[kainc] test report: scanning " + spec_root)

    // Collect test results by scanning for .kn files and running test_run on each
    var passed: Int = 0
    var failed: Int = 0

    // Scan spec_root directory for .kn files
    let dir_listing: String = abi_fs_read_dir_paths_text(spec_root)
    if dir_listing == "":
        println("[kainc] test report: no test files found in " + spec_root)
        let empty_json: String = "{\"passed\": 0, \"failed\": 0, \"total\": 0, \"results\": []}"
        if output_path != "":
            fs_write_text(output_path, empty_json)
            return output_path
        let default_path: String = "spec/test_report.json"
        fs_write_text(default_path, empty_json)
        return default_path

    // Parse directory listing — each line is a path
    // First pass: count .kn files
    var kn_count: Int = 0
    var line_start: Int = 0
    var char_idx: Int = 0
    while char_idx < len(dir_listing):
        if dir_listing[char_idx] == "\n":
            var ci: Int = line_start
            var file_path: String = ""
            while ci < char_idx:
                file_path = file_path + dir_listing[ci]
                ci = ci + 1
            if len(file_path) > 3:
                let ext_start: Int = len(file_path) - 3
                if file_path[ext_start] == "." and file_path[ext_start + 1] == "k" and file_path[ext_start + 2] == "n":
                    kn_count = kn_count + 1
            line_start = char_idx + 1
        char_idx = char_idx + 1

    // Allocate file_paths as flat string, parse per-file results directly
    // (avoid arrays entirely — codegen limitation with method calls)
    var fi: Int = 0
    var json: String = "{\n  \"passed\": 0,\n  \"failed\": 0,\n  \"total\": 0,\n  \"results\": ["

    // Re-scan and process each .kn file as we find it
    line_start = 0
    char_idx = 0
    while char_idx < len(dir_listing):
        if dir_listing[char_idx] == "\n":
            var ci: Int = line_start
            var file_path: String = ""
            while ci < char_idx:
                file_path = file_path + dir_listing[ci]
                ci = ci + 1
            if len(file_path) > 3:
                let ext_start: Int = len(file_path) - 3
                if file_path[ext_start] == "." and file_path[ext_start + 1] == "k" and file_path[ext_start + 2] == "n":
                    // Found a .kn file — run it immediately
                    let test_src: String = fs_read_text(file_path)
                    var exit_code: Int = 0
                    if test_src != "":
                        exit_code = handler_test_run(file_path)
                    if exit_code == 0:
                        passed = passed + 1
                    else:
                        failed = failed + 1
                    if fi > 0:
                        json = json + ","
                    json = json + "{\"name\":\"" + file_path + "\",\"passed\":" + str(exit_code == 0) + "}"
                    fi = fi + 1
            line_start = char_idx + 1
        char_idx = char_idx + 1

    let total: Int = passed + failed
    json = json + "]\n}\n"

    // Write report
    let report_path: String = output_path
    if report_path == "":
        report_path = "spec/test_report.json"
    fs_write_text(report_path, json)
    println("[kainc] test report written: " + report_path + " (passed=" + str(passed) + ", failed=" + str(failed) + ", total=" + str(total) + ")")
    return report_path

pub fn handler_build_link(out_dir: String, target: String) -> Int with IO:
    println("[kainc] build link: out_dir=" + out_dir + " target=" + target)

    // Collect all .ll files from out_dir
    let dir_listing: String = abi_fs_read_dir_paths_text(out_dir)
    if dir_listing == "":
        println("[kainc] link: no .ll files found in " + out_dir)
        return 1

    // Build clang link command by scanning .ll files inline
    var cmd: String = "clang -O2"
    var line_start: Int = 0
    var char_idx: Int = 0
    while char_idx < len(dir_listing):
        if dir_listing[char_idx] == "\n":
            var file_path: String = ""
            var ci: Int = line_start
            while ci < char_idx:
                file_path = file_path + dir_listing[ci]
                ci = ci + 1
            if len(file_path) > 3:
                let ext_start: Int = len(file_path) - 3
                if file_path[ext_start] == "." and file_path[ext_start + 1] == "l" and file_path[ext_start + 2] == "l":
                    cmd = cmd + " " + file_path
            line_start = char_idx + 1
        char_idx = char_idx + 1

    if cmd == "clang -O2":
        println("[kainc] link: no .ll files found in " + out_dir)
        return 1

    cmd = cmd + " -lkain_runtime -o kainc.exe"

    println("[kainc] link command: " + cmd)

    // Try to invoke linker via os_system
    // os_system returns 0 on success, non-zero on failure
    let result: Int = os_system(cmd)
    if result != 0:
        println("[kainc] link: clang returned exit code " + str(result))
        println("[kainc] link: (ensure clang is on PATH and kain_runtime.lib is available)")
        return result

    println("[kainc] link: SUCCESS → kainc.exe")
    return 0

pub fn handler_build_package(project_root: String) -> Int with IO:
    println("[kainc] build package: " + project_root)
    println("[kainc] ========================================")

    // Phase 1: Check all source files
    println("[kainc] [1/3] Checking sources...")
    let src_root: String = project_root + "/src"
    let check_result: Int = handler_compile_check(src_root + "/main.kn")
    if check_result != 0:
        println("[kainc] build package: CHECK FAILED (exit=" + str(check_result) + ")")
        return check_result
    println("[kainc] [1/3] Check PASSED")

    // Phase 2: Codegen
    println("[kainc] [2/3] Compiling codegen...")
    let codegen_result: Int = handler_compile_codegen(src_root + "/main.kn", "llvm", "debug")
    if codegen_result != 0:
        println("[kainc] build package: CODEGEN FAILED (exit=" + str(codegen_result) + ")")
        return codegen_result
    println("[kainc] [2/3] Codegen PASSED")

    // Phase 3: Link
    println("[kainc] [3/3] Linking...")
    let out_dir: String = project_root + "/out"
    let link_result: Int = handler_build_link(out_dir, "llvm")
    if link_result != 0:
        println("[kainc] build package: LINK FAILED (exit=" + str(link_result) + ")")
        return link_result
    println("[kainc] [3/3] Link PASSED")

    println("[kainc] ========================================")
    println("[kainc] BUILD PACKAGE: SUCCESS")
    return 0

// ═════════════════════════════════════════════════════════════════════════════
// strip_local_imports — remove `use` lines that import local files
//
// Combined source already has all definitions inline. Local `use module`
// imports trigger module resolution and pull in original files, causing
// duplicate symbol errors. Keep `use std::*` lines (stdlib imports).
// ═════════════════════════════════════════════════════════════════════════════

pub fn strip_local_imports(text: String) -> String:
    var output: String = ""
    let lines: Array<String> = text_split_lines(text)
    var li: Int = 0
    while li < len(lines):
        let ln: String = lines[li]
        // Keep lines that are NOT local file imports
        if text_starts_with_string(ln, "use "):
            // Strip only bare module imports (not use std::*)
            if text_starts_with_string(ln, "use std::"):
                output = output + ln + "\n"
            // else: skip this line (it's a local file import)
        else:
            output = output + ln + "\n"
        li = li + 1
    return output

// ═════════════════════════════════════════════════════════════════════════════
// dedup_combined_source — strip duplicate top-level definitions
//
// Uses std::text functions (text_starts_with_string, text_substring_string)
// to avoid per-character array indexing on large strings.
// ═════════════════════════════════════════════════════════════════════════════

pub fn dedup_combined_source(text: String) -> String:
    var seen_names: String = "|"
    var output: String = ""

    // Split into lines and process each
    let lines: Array<String> = text_split_lines(text)
    var skip_def: Bool = false
    var li: Int = 0
    while li < len(lines):
        let ln: String = lines[li]

        // Check for top-level declarations
        var is_def: Bool = false
        var name_start: Int = 0
        if text_starts_with_string(ln, "pub struct "):
            is_def = true
            name_start = 11
        elif text_starts_with_string(ln, "pub fn "):
            is_def = true
            name_start = 7
        elif text_starts_with_string(ln, "pub const "):
            is_def = true
            name_start = 11
        elif text_starts_with_string(ln, "pub type "):
            is_def = true
            name_start = 9
        elif text_starts_with_string(ln, "type "):
            is_def = true
            name_start = 5
        elif text_starts_with_string(ln, "const "):
            if text_starts_with_string(ln, "const "):
                is_def = true
                name_start = 6

        if skip_def and is_def:
            skip_def = false
            // Fall through to process this new declaration

        if is_def:
            // Extract symbol name
            var symbol_name: String = ""
            var ni: Int = name_start
            while ni < len(ln):
                let nc: String = text_substring_string(ln, ni, 1)
                if nc == ":" or nc == "(" or nc == " " or nc == "=":
                    ni = len(ln)  // break
                else:
                    symbol_name = symbol_name + nc
                ni = ni + 1

            if symbol_name != "":
                let marker: String = "|" + symbol_name + "|"
                if text_contains_string(seen_names, marker):
                    skip_def = true
                    li = li + 1
                    continue
                else:
                    seen_names = seen_names + symbol_name + "|"

        if skip_def:
            li = li + 1
            continue

        output = output + ln + "\n"
        li = li + 1

    return output 

// ═════════════════════════════════════════════════════════════════════════════

pub fn handler_selfhost_phase1(project_root: String) -> Int with IO:
    println("[kainc] selfhost phase1: combining sources from " + project_root)

    // Combine all source files in SOURCE_ORDER into one monolithic source
    let src_root: String = project_root
    var combined: String = ""

    // Header
    combined = combined + "// ═══════════════════════════════════════════════════════════════════\n"
    combined = combined + "//  kainc_bootstrap.kn — Ouroboros Combined Source\n"
    combined = combined + "//  Generated by: kainc selfhost phase1\n"
    combined = combined + "//  Source files: " + str(len(SOURCE_ORDER)) + "\n"
    combined = combined + "// ═══════════════════════════════════════════════════════════════════\n\n"

    var fi: Int = 0
    var files_read: Int = 0
    while fi < len(SOURCE_ORDER):
        let file_name: String = SOURCE_ORDER[fi]
        let file_path: String = src_root + "/" + file_name

        combined = combined + "\n"
        combined = combined + "// ── BEGIN: " + file_name + " ──\n\n"

        let source: String = fs_read_text(file_path)
        if source == "":
            println("[kainc] phase1: WARNING — cannot read " + file_path)
            combined = combined + "// WARNING: " + file_name + " could not be read\n"
        else:
            combined = combined + source
            combined = combined + "\n"
            files_read = files_read + 1

        combined = combined + "\n// ── END: " + file_name + " ──\n"
        fi = fi + 1

    println("[kainc] phase1: read " + str(files_read) + " / " + str(len(SOURCE_ORDER)) + " source files")

    // ── Strip local imports: combined source has all defs inline ──
    let stripped: String = strip_local_imports(combined)
    let strip_kb: Int = (len(combined) - len(stripped)) / 1000
    println("[kainc] phase1: stripped ~" + str(strip_kb) + " KB of local imports")
    combined = stripped

    // ── Dedup pass: strip duplicate top-level definitions ──
    let deduped: String = dedup_combined_source(combined)
    let removed_kb: Int = (len(combined) - len(deduped)) / 1000
    println("[kainc] phase1: dedup removed ~" + str(removed_kb) + " KB of duplicates")
    combined = deduped

    // Write combined source
    let out_dir: String = project_root + "/.selfhost/bootstrap/combined"
    // Ensure directory exists
    let mkdir_result: Int = abi_fs_create_dir_all(out_dir)
    let _ = mkdir_result

    let out_path: String = out_dir + "/kainc_bootstrap.kn"
    fs_write_text(out_path, combined)
    println("[kainc] phase1: combined source written to " + out_path)
    println("[kainc] phase1: combined size = " + str(len(combined)) + " bytes")

    // Run compile_check on the combined source
    println("[kainc] phase1: running compile check on combined source...")
    let check_result: Int = handler_compile_check(out_path)
    if check_result != 0:
        println("[kainc] phase1: compile check FAILED on combined source")
        return check_result

    println("[kainc] phase1: compile check PASSED on combined source")
    return 0

pub fn handler_selfhost_phase2(project_root: String, verify: Bool) -> Int with IO:
    println("[kainc] selfhost phase2: ouroboros verification")

    // Step 1: Compile the workspace via kain build (bootstrap compiler)
    println("[kainc] phase2: stage 1 — compiling workspace via bootstrap...")
    let build_cmd: String = "kain build " + project_root + " --target llvm"
    println("[kainc] invoking: " + build_cmd)
    let build_result: Int = os_system(build_cmd)
    if build_result != 0:
        println("[kainc] phase2: stage 1 build FAILED (exit=" + str(build_result) + ")")
        println("[kainc] phase2: OUROBOROS NOT READY")
        return 2

    // Step 2: Find the built kainc.exe
    let stage1_exe: String = project_root + "/.kain/out/x86_64-windows/dev/project/kainc/llvm/main.exe"
    println("[kainc] phase2: stage 1 exe: " + stage1_exe)

    if verify == false:
        println("[kainc] phase2: stage 1 build succeeded (no verification requested)")
        return 0

    // Step 3: Run stage1.exe to compile itself (ouroboros)
    println("[kainc] phase2: stage 2 — running stage1.exe to self-compile...")
    let stage2_cmd: String = stage1_exe + " selfhost " + project_root
    let stage2_exit: Int = os_system(stage2_cmd)
    if stage2_exit != 0:
        println("[kainc] phase2: stage 2 self-compile FAILED (exit=" + str(stage2_exit) + ")")
        println("[kainc] phase2: OUROBOROS NOT READY: kainc.exe cannot compile itself yet")
        return 2

    println("[kainc] phase2: ╔══════════════════════════════════════╗")
    println("[kainc] phase2: ║   OUROBOROS VERIFIED              ║")
    println("[kainc] phase2: ║   kainc.exe compiled itself       ║")
    println("[kainc] phase2: ╚══════════════════════════════════════╝")
    return 0

// ═════════════════════════════════════════════════════════════════════════════
// OrchState — VM handle + config + tracking fields
// ═════════════════════════════════════════════════════════════════════════════

pub struct OrchState:
    vm:           MarkScriptVM
    config:       BuildConfig
    source_files: Array<String>
    diagnostics:  Diagnostics
    test_results: Array<TestResult>

// ═════════════════════════════════════════════════════════════════════════════
// init_orchestrator — create VM, register handlers, load config
// ═════════════════════════════════════════════════════════════════════════════

pub fn init_orchestrator(config_path: String) -> OrchState with IO:
    let config_vm: MarkScriptVM = mks_run_file(config_path)
    let vm: MarkScriptVM = register_compiler_handlers(config_vm)
    let config: BuildConfig = load_build_config(vm)
    return OrchState {
        vm:           vm,
        config:       config,
        source_files: [],
        diagnostics:  diagnostics_new(),
        test_results: [],
    }

// ═════════════════════════════════════════════════════════════════════════════
// register_compiler_handlers — register all 9 IVT handlers into the VM
// ═════════════════════════════════════════════════════════════════════════════

pub fn register_compiler_handlers(vm: MarkScriptVM) -> MarkScriptVM with IO:
    var v = vm
    v = mks_register(v, "compile check",   HANDLER_COMPILE_CHECK)
    v = mks_register(v, "compile codegen",  HANDLER_COMPILE_CODEGEN)
    v = mks_register(v, "compile jit",      HANDLER_COMPILE_JIT)
    v = mks_register(v, "test run",         HANDLER_TEST_RUN)
    v = mks_register(v, "test report",      HANDLER_TEST_REPORT)
    v = mks_register(v, "build link",       HANDLER_BUILD_LINK)
    v = mks_register(v, "build package",    HANDLER_BUILD_PACKAGE)
    v = mks_register(v, "selfhost phase1",  HANDLER_SELFHOST_PHASE1)
    v = mks_register(v, "selfhost phase2",  HANDLER_SELFHOST_PHASE2)
    return v

// ═════════════════════════════════════════════════════════════════════════════
// load_build_config — read build config from markscript Metadata table
// ═════════════════════════════════════════════════════════════════════════════

pub fn load_build_config(vm: MarkScriptVM) -> BuildConfig with IO:
    let handle: Int = mks_find_table(vm, "Metadata")
    if handle < 0:
        println("[ORCH] Warning: Metadata table not found, using defaults")
        return build_config_default()

    let rows: Int = mks_table_rows(vm, handle)
    if rows == 0:
        return build_config_default()

    let mut config: BuildConfig = build_config_default()

    var row: Int = 0
    while row < rows:
        let key: String   = mks_table_get_string(vm, handle, row, 0, "")
        let value: String = mks_table_get_string(vm, handle, row, 1, "")

        if key == "name":
            config.name = value
        elif key == "target":
            config.target = value
        elif key == "profile":
            config.profile = value
        elif key == "optimize":
            config.optimize = value == "true" or value == "1"
        elif key == "lto":
            config.lto = value
        elif key == "entry":
            config.entry = value
        elif key == "source_root":
            config.source_root = value
        elif key == "deps":
            config.deps = value
        elif key == "output":
            config.output = value
        elif key == "runtime":
            config.runtime = value
        elif key == "linker":
            config.linker = value
        elif key == "linker_flags":
            config.linker_flags = value
        elif key == "cc":
            config.cc = value
        elif key == "cc_flags":
            config.cc_flags = value
        elif key == "test_root":
            config.test_root = value
        elif key == "doc_root":
            config.doc_root = value

        row = row + 1

    return config

// ═════════════════════════════════════════════════════════════════════════════
// run_build_pipeline — execute buildex.md through the VM
// ═════════════════════════════════════════════════════════════════════════════

pub fn run_build_pipeline(pipeline_path: String, orch: OrchState) -> Int with IO:
    let source: String = fs_read_text(pipeline_path)
    if source == "":
        println("[ORCH] Error: pipeline file not found: " + pipeline_path)
        return 1

    let _result_vm: MarkScriptVM = mks_run_with_vm(orch.vm, source)
    return 0

// ═════════════════════════════════════════════════════════════════════════════
// run_stage — execute a named build stage
// ═════════════════════════════════════════════════════════════════════════════

pub fn run_stage(stage_name: String, orch: OrchState) -> Int with IO:
    println("[ORCH] Running stage: " + stage_name)
    let result: Int = run_build_pipeline("buildex.md", orch)
    return result

// ═════════════════════════════════════════════════════════════════════════════
// orchestrator_build — full build pipeline execution
// ═════════════════════════════════════════════════════════════════════════════

pub fn orchestrator_build(orch: OrchState, stage: String) -> Int with IO:
    var build_stage: String = "BuildAll"
    if stage != "":
        build_stage = stage

    println("[ORCH] Build: " + build_stage + " (target: " + orch.config.target + ", profile: " + orch.config.profile + ")")

    // For bootstrap: delegate to handler_compile_codegen (shells out to kain build)
    // The markscript pipeline (buildex.md) is for full orchestrated builds
    let source_path: String = orch.config.entry
    if source_path == "":
        source_path = "src/main.kn"
    return handler_compile_codegen(source_path, orch.config.target, orch.config.profile)

// ═════════════════════════════════════════════════════════════════════════════
// orchestrator_check — quick typecheck-only verification
// ═════════════════════════════════════════════════════════════════════════════

pub fn orchestrator_check(orch: OrchState, path: String) -> Int with IO:
    println("[ORCH] Check: " + path)
    let result: Int = handler_compile_check(path)
    return result

// ═════════════════════════════════════════════════════════════════════════════
// orchestrator_test — run test suite
// ═════════════════════════════════════════════════════════════════════════════

pub fn orchestrator_test(orch: OrchState, spec_path: String) -> Int with IO:
    println("[ORCH] Test: " + spec_path)
    let result: Int = handler_test_run(spec_path)
    return result

// ═════════════════════════════════════════════════════════════════════════════
// orchestrator_selfhost — self-host verification pipeline
// ═════════════════════════════════════════════════════════════════════════════

pub fn orchestrator_selfhost(orch: OrchState, project_root: String, verify: Bool) -> Int with IO:
    println("[ORCH] SelfHost: project=" + project_root + " verify=" + str(verify))
    let phase1_result: Int = handler_selfhost_phase1(project_root)
    if phase1_result != 0:
        return phase1_result
    let phase2_result: Int = handler_selfhost_phase2(project_root, verify)
    return phase2_result

// ═════════════════════════════════════════════════════════════════════════════
// CLI entry points — called by GOLF's cli.kn / main.kn
// ═════════════════════════════════════════════════════════════════════════════

pub fn orch_build_cli(input_path: String, target: String, profile: String, stage: String) -> Int with IO:
    let orch: OrchState = init_orchestrator("build.md")
    orch.config.target = target
    orch.config.profile = profile
    orch.config.entry = input_path
    return orchestrator_build(orch, stage)

pub fn orch_check_cli(input_path: String) -> Int with IO:
    let orch: OrchState = init_orchestrator("build.md")
    return orchestrator_check(orch, input_path)

pub fn orch_run_cli(input_path: String) -> Int with IO:
    let orch: OrchState = init_orchestrator("build.md")
    return handler_compile_jit(input_path)

pub fn orch_test_cli(input_path: String) -> Int with IO:
    let orch: OrchState = init_orchestrator("build.md")
    return orchestrator_test(orch, input_path)

pub fn orch_selfhost_cli(project_root: String, verify: Bool) -> Int with IO:
    let orch: OrchState = init_orchestrator("build.md")
    return orchestrator_selfhost(orch, project_root, verify)

// ═════════════════════════════════════════════════════════════════════════════
// Utility: print build config summary (for diagnostics)
// ═════════════════════════════════════════════════════════════════════════════

pub fn print_config(config: BuildConfig) with IO:
    println("[CONFIG]")
    println("  name:         " + config.name)
    println("  target:       " + config.target)
    println("  profile:      " + config.profile)
    println("  optimize:     " + str(config.optimize))
    println("  lto:          " + config.lto)
    println("  entry:        " + config.entry)
    println("  source_root:  " + config.source_root)
    println("  deps:         " + config.deps)
    println("  output:       " + config.output)
    println("  runtime:      " + config.runtime)
    println("  linker:       " + config.linker)
    println("  linker_flags: " + config.linker_flags)
    println("  cc:           " + config.cc)
    println("  cc_flags:     " + config.cc_flags)
    println("  test_root:    " + config.test_root)
    println("  doc_root:     " + config.doc_root)

// ═════════════════════════════════════════════════════════════════════════════
// 20 std::markscript functions used (complete list):
//
//   1.  mks_new_vm
//   2.  mks_register
//   3.  mks_run_file
//   4.  mks_run_string
//   5.  mks_run_with_vm
//   6.  mks_tables
//   7.  mks_table
//   8.  mks_table_get_int
//   9.  mks_table_get_string
//  10.  mks_table_get_float
//  11.  mks_find_table
//  12.  mks_table_rows
//  13.  mks_table_cols
//  14.  mks_get_var
//  15.  mks_to_int
//  16.  mks_to_string
//  17.  mks_to_float
//  18.  mks_find_widget
//  19.  mks_create_widget
//  20.  mks_widget_set / mks_widget_get
// ═════════════════════════════════════════════════════════════════════════════

// ============================================================================
// codegen/codegen.kn
// ============================================================================
// codegen.kn — Two-path LLVM codegen: textual .ll + LLVM-C API
// STREAM: BLUE + GOLF — CODEGEN COMPLETION
//
// Path A (textual .ll): string-based emission — always works, zero LLVM dep.
// Path B (LLVM-C API): in-memory IR construction for JIT.
//
// Generates complete LLVM IR from a MonomorphizedProgram.
//
// All expression compilers are REAL — they walk the flat AST via node indices
// and produce properly formatted LLVM IR text. Every binary operation, control
// flow construct, function call, struct literal, and variable access is lowered
// to the correct LLVM instruction sequence.

use std::fmt

// ── L7 + GPU codegen stubs (BLUE stream — real emission deferred) ──
// compile_spawn_textual stays in this file at ~2412.
// The compile_actor_spawn / compile_ownership_op stubs in L7_systems.kn
// and compile_shader_artifact / compile_dispatch_stmt stubs in GPU.kn
// will be wired into compile_expr_textual / compile_stmt_textual during
// the BLUE stream.

// ═══════════════════════════════════════════════════════════════════
// Local LLVM-C type aliases (Path B stubs — real in llvm_ffi.kn)
// ═══════════════════════════════════════════════════════════════════

// NOTE: runtime_table_init() is defined in runtime.kn (real 132-entry table).
// This local stub provides a fallback for standalone check.
// At combine time, runtime.kn's version (defined first) takes precedence.

// ── Fallback: minimum core runtime declares when RuntimeTable is empty ──

pub fn core_runtime_declares_fallback() -> String:
    var decls: String = ""
    decls = decls + "declare void @print_i64(i64)\n"
    decls = decls + "declare void @print_f64(double)\n"
    decls = decls + "declare void @print_bool(i1)\n"
    decls = decls + "declare void @print_str(i8*, i64)\n"
    decls = decls + "declare void @print_ptr(i8*)\n"
    decls = decls + "declare i8* @KAIN_alloc(i64)\n"
    decls = decls + "declare void @KAIN_free(i8*)\n"
    decls = decls + "declare i8* @KAIN_realloc(i8*, i64)\n"
    decls = decls + "declare i64 @strlen(i8*)\n"
    decls = decls + "declare i32 @strcmp(i8*, i8*)\n"
    decls = decls + "declare i8* @str_concat(i8*, i8*)\n"
    decls = decls + "declare i8* @string_new(i8*)\n"
    decls = decls + "declare i8* @to_string(i64)\n"
    decls = decls + "declare i8* @to_string_f64(double)\n"
    decls = decls + "declare void @abi_panic(i8*, i64)\n"
    decls = decls + "declare void @abi_debug_break()\n"
    decls = decls + "declare i64 @abi_runtime_init()\n"
    decls = decls + "declare i64 @abi_runtime_shutdown()\n"
    return decls

// ── runtime_fn_to_declare — format a single RuntimeFunction as LLVM declare ──

// ── LLVM-C API stubs (Path B, in-memory) ──

// ═══════════════════════════════════════════════════════════════════
// CodegenState — accumulates LLVM IR text + tracking state
// ═══════════════════════════════════════════════════════════════════

pub struct CgLoopLabel:
    continue_label: String
    break_label:    String

pub struct LocalEntry:
    name: String
    reg:  String
    ty:   String

pub struct StructEntry:
    name:   String
    fields: String

pub struct StringConstEntry:
    global_name: String
    content:     String
    length:      Int

pub struct LlvmGenerator:
    output:             String
    reg_count:          Int
    label_count:        Int
    global_const_count: Int
    locals:             Array<LocalEntry>
    struct_defs:        Array<StructEntry>
    loop_stack:         Array<CgLoopLabel>
    string_consts:      Array<StringConstEntry>
    indent_level:       Int
    program_items:      Array<TypedItem>
    program_ast:        Array<AstNode>

pub fn llvm_gen_new() -> LlvmGenerator:
    return LlvmGenerator {
        output:             "",
        reg_count:          0,
        label_count:        0,
        global_const_count: 0,
        locals:             [],
        struct_defs:        [],
        loop_stack:         [],
        string_consts:      [],
        indent_level:       0,
        program_items:      [],
        program_ast:        [],
    }

// ── Result structs for value-semantics codegen ──

pub struct GenResult:
    gen: LlvmGenerator
    reg: String

pub struct GenTypeResult:
    gen:      LlvmGenerator
    reg:      String
    llvm_type: String

pub struct GenVoidResult:
    gen: LlvmGenerator

// ═══════════════════════════════════════════════════════════════════
// Register and Label Counters
// ═══════════════════════════════════════════════════════════════════

pub fn next_reg(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let reg: String = "%" + str(r.reg_count)
    let mut next: LlvmGenerator = r
    next.reg_count = next.reg_count + 1
    return GenResult { gen: next, reg: reg }

pub fn next_label(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let label: String = ".L" + str(r.label_count)
    let mut next: LlvmGenerator = r
    next.label_count = next.label_count + 1
    return GenResult { gen: next, reg: label }

pub fn next_global_const(gen: LlvmGenerator) -> GenResult:
    let r: LlvmGenerator = gen
    let name: String = "@.str." + str(r.global_const_count)
    let mut next: LlvmGenerator = r
    next.global_const_count = next.global_const_count + 1
    return GenResult { gen: next, reg: name }

// ═══════════════════════════════════════════════════════════════════
// Output Helpers
// ═══════════════════════════════════════════════════════════════════

pub fn emit_line(gen: LlvmGenerator, text: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    var i: Int = 0
    while i < r.indent_level:
        r.output = r.output + "  "
        i = i + 1
    r.output = r.output + text + "\n"
    return r

pub fn emit_raw(gen: LlvmGenerator, text: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.output = r.output + text
    return r

pub fn emit_blank(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.output = r.output + "\n"
    return r

pub fn emit_indent(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r.indent_level = r.indent_level + 1
    return r

pub fn emit_dedent(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    if r.indent_level > 0:
        r.indent_level = r.indent_level - 1
    return r

// ═══════════════════════════════════════════════════════════════════
// Local Variable Management (parallel arrays — no HashMap)
// ═══════════════════════════════════════════════════════════════════

pub fn locals_find(gen: LlvmGenerator, name: String) -> Int:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return i
        i = i + 1
    return -1

pub fn locals_add(gen: LlvmGenerator, name: String, reg: String, ty: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let entry: LocalEntry = LocalEntry { name: name, reg: reg, ty: ty }
    push(r.locals, entry)
    return r

pub fn locals_get_reg(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return gen.locals[i].reg
        i = i + 1
    return ""

pub fn locals_get_ty(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.locals):
        if gen.locals[i].name == name:
            return gen.locals[i].ty
        i = i + 1
    return ""

// ═══════════════════════════════════════════════════════════════════
// Struct Definition Registration
// ═══════════════════════════════════════════════════════════════════

pub fn struct_defs_register(gen: LlvmGenerator, name: String, fields: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let entry: StructEntry = StructEntry { name: name, fields: fields }
    push(r.struct_defs, entry)
    return r

pub fn struct_defs_find(gen: LlvmGenerator, name: String) -> String:
    var i: Int = 0
    while i < len(gen.struct_defs):
        if gen.struct_defs[i].name == name:
            return gen.struct_defs[i].fields
        i = i + 1
    return ""

// ═══════════════════════════════════════════════════════════════════
// Loop Stack Management
// ═══════════════════════════════════════════════════════════════════

pub fn loop_push(gen: LlvmGenerator, continue_label: String, break_label: String) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let label: CgLoopLabel = CgLoopLabel { continue_label: continue_label, break_label: break_label }
    push(r.loop_stack, label)
    return r

pub fn loop_pop(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    if len(r.loop_stack) > 0:
        pop(r.loop_stack)
    return r

pub fn loop_continue_label(gen: LlvmGenerator) -> String:
    if len(gen.loop_stack) == 0:
        return ""
    let idx: Int = len(gen.loop_stack) - 1
    return gen.loop_stack[idx].continue_label

pub fn loop_break_label(gen: LlvmGenerator) -> String:
    if len(gen.loop_stack) == 0:
        return ""
    let idx: Int = len(gen.loop_stack) - 1
    return gen.loop_stack[idx].break_label

// ═══════════════════════════════════════════════════════════════════
// Kain ResolvedType → LLVM IR Type String (COMPLETE mapping)
// ═══════════════════════════════════════════════════════════════════

pub fn map_type_to_llvm(ty: ResolvedType) -> String:
    let k: Int = ty.kind

    if k == RT_UNIT or k == RT_NEVER:
        return "void"
    if k == RT_BOOL:
        return "i1"
    if k == RT_INT:
        let sz: Int = ty.int_size
        if sz < 0:      // unsigned
            let usz: Int = 0 - sz
            if usz == 1:  return "i8"
            if usz == 2:  return "i16"
            if usz == 4:  return "i32"
            if usz == 8:  return "i64"
            if usz == 16: return "i128"
        if sz == 1 or sz == -1:   return "i8"
        if sz == 2 or sz == -2:   return "i16"
        if sz == 4 or sz == -4:   return "i32"
        if sz == 8 or sz == -8:   return "i64"
        if sz == 16 or sz == -16: return "i128"
        return "i64"
    if k == RT_FLOAT:
        if ty.float_size == 4:
            return "float"
        return "double"
    if k == RT_STRING:
        return "{i8*, i64}"
    if k == RT_CHAR:
        return "i32"
    if k == RT_PTR or k == RT_REF:
        return "ptr"
    if k == RT_STRUCT:
        return "%struct_" + str(ty.name)
    if k == RT_ENUM:
        return "i64"
    if k == RT_ARRAY:
        let inner: String = "i64"
        return "[" + str(ty.array_len) + " x " + inner + "]"
    if k == RT_SLICE:
        return "{i8*, i64}"
    if k == RT_TUPLE:
        return "{i64}"
    if k == RT_OPTION:
        return "{i64, i64}"
    if k == RT_RESULT:
        return "{i64, i64, i64}"
    if k == RT_FUTURE:
        return "ptr"
    if k == RT_FUNCTION:
        return "ptr"
    if k == RT_GENERIC or k == RT_UNKNOWN:
        return "i64"

    return "i64"

// ── Default value initializer for an LLVM type ──

pub fn map_llvm_zero(ty_str: String) -> String:
    if ty_str == "i1":    return "0"
    if ty_str == "i8":    return "0"
    if ty_str == "i16":   return "0"
    if ty_str == "i32":   return "0"
    if ty_str == "i64":   return "0"
    if ty_str == "i128":  return "0"
    if ty_str == "float":   return "0.0"
    if ty_str == "double":  return "0.0"
    if ty_str == "ptr":   return "null"
    if ty_str == "void":  return "void"
    return "zeroinitializer"

// ═══════════════════════════════════════════════════════════════════
// PATH A: codegen_textual — main entry point
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_textual(program: MonomorphizedProgram,
                        target_triple: String,
                        debug: Bool) -> String:
    let mut gen: LlvmGenerator = llvm_gen_new()
    gen.program_items = program.items
    gen.program_ast = program.ast_nodes

    // ── Module Header ──
    gen = emit_raw(gen, "; ── Generated by kainc (Kain Self-Host Compiler) ──\n")
    gen = emit_raw(gen, "target triple = \"" + target_triple + "\"\n")
    gen = emit_raw(gen, "target datalayout = \"" + data_layout_string() + "\"\n")
    gen = emit_blank(gen)

    // ── Module Flags ──
    gen = emit_raw(gen, "; Module flags\n")
    gen = emit_raw(gen, "!llvm.module.flags = !{!0}\n")
    gen = emit_raw(gen, "!0 = !{i32 1, !\"wchar_size\", i32 2}\n")
    gen = emit_blank(gen)

    // ── Attribute Groups ──
    gen = emit_attribute_groups(gen)

    // ── Global String Constants ──
    gen = emit_raw(gen, "; ── Global String Constants ──\n")
    gen = emit_global_strings(gen, program)
    gen = emit_blank(gen)

    // ── Runtime Function Declarations ──
    let table: RuntimeTable = runtime_table_init()
    gen = emit_raw(gen, emit_runtime_declares(table))

    // ── Struct Type Definitions ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Struct Type Definitions ──\n")
    gen = emit_struct_defs_from_program(gen, program)
    gen = emit_blank(gen)

    // ── Global Constants (const items) ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Global Constants ──\n")
    gen = emit_const_globals(gen, program)
    gen = emit_blank(gen)

    // ── Function Definitions ──
    gen = emit_blank(gen)
    gen = emit_raw(gen, "; ── Function Definitions ──\n")

    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_FUNCTION:
            gen = compile_function_textual(gen, item, program.ast_nodes)
        i = i + 1

    return gen.output

// ═══════════════════════════════════════════════════════════════════
// emit_attribute_groups — standard attribute sets
// ═══════════════════════════════════════════════════════════════════

pub fn emit_attribute_groups(gen: LlvmGenerator) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    r = emit_raw(r, "; ── Attribute Groups ──\n")
    r = emit_raw(r, "attributes #0 = { nounwind readnone }\n")
    r = emit_raw(r, "attributes #1 = { nounwind }\n")
    r = emit_raw(r, "attributes #2 = { nounwind uwtable }\n")
    r = emit_blank(r)
    return r

// ═══════════════════════════════════════════════════════════════════
// emit_struct_defs_from_program — REAL struct type definitions
// ═══════════════════════════════════════════════════════════════════

pub fn emit_struct_defs_from_program(gen: LlvmGenerator,
                                      program: MonomorphizedProgram) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen

    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_STRUCT:
            let name_idx: Int = item.name_idx
            let type_name: String = "%struct_" + str(name_idx)

            // Walk AST to extract field types from the struct's AST node
            let ast_idx: Int = item.ast_index
            var field_types_str: String = ""
            if ast_idx >= 0 and ast_idx < len(program.ast_nodes):
                let fcount: Int = len(item.field_types)
                var fi: Int = 0
                while fi < fcount:
                    if fi > 0:
                        field_types_str = field_types_str + ", "
                    let ft: ResolvedType = item.field_types[fi]
                    field_types_str = field_types_str + map_type_to_llvm(ft)
                    fi = fi + 1

            if field_types_str == "":
                field_types_str = "i8"

            // Register struct definition for field access lookups
            r = struct_defs_register(r, type_name, field_types_str)
            r = emit_raw(r, type_name + " = type { " + field_types_str + " }\n")

        elif item.kind == AST_ITEM_ENUM:
            let name_idx: Int = item.name_idx
            let type_name: String = "%enum_" + str(name_idx)
            // Tagged union: { i64 tag, [8 x i8] payload }
            let enum_fields: String = "i64, [8 x i8]"
            r = struct_defs_register(r, type_name, enum_fields)
            r = emit_raw(r, type_name + " = type { " + enum_fields + " }\n")
        i = i + 1

    return r

// ═══════════════════════════════════════════════════════════════════
// emit_const_globals — emit AST_ITEM_CONST as LLVM global constants
// ═══════════════════════════════════════════════════════════════════

pub fn emit_const_globals(gen: LlvmGenerator,
                           program: MonomorphizedProgram) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen

    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_CONST:
            let ty: ResolvedType = item.resolved_type
            let llvm_ty: String = map_type_to_llvm(ty)
            let const_name: String = "@const_" + str(item.name_idx)
            let zero_val: String = map_llvm_zero(llvm_ty)
            r = emit_raw(r, const_name + " = constant " + llvm_ty + " " + zero_val + "\n")
        i = i + 1

    return r

// ═══════════════════════════════════════════════════════════════════
// emit_global_strings — emit global string constants
// ═══════════════════════════════════════════════════════════════════

pub fn emit_global_strings(gen: LlvmGenerator,
                            program: MonomorphizedProgram) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen

    // Walk AST to collect all string literal expressions
    var string_pool: Array<String> = []        // unique string values
    var string_global_names: Array<String> = [] // corresponding global names

    var ai: Int = 0
    while ai < len(program.ast_nodes):
        let node: AstNode = program.ast_nodes[ai]
        if node.kind == AST_EXPR_STRING:
            // Extract string content from AST node data
            let sd: Array<Int> = node.data
            let sdlen: Int = len(sd)
            var str_content: String = ""
            if sdlen > 0:
                let str_len: Int = sd[0]
                var ci: Int = 0
                while ci < str_len and (ci + 1) < sdlen:
                    let byte_val: Int = sd[ci + 1]
                    if byte_val > 0 and byte_val < 128:
                        str_content = str_content + byte_val_to_escaped_char(byte_val)
                    ci = ci + 1

            // Check if already in pool
            var found: Bool = false
            var si: Int = 0
            while si < len(string_pool):
                if string_pool[si] == str_content:
                    found = true
                    si = len(string_pool)
                si = si + 1

            if found == false and str_content != "":
                let s_gn: String = "@.str." + str(len(string_pool))
                push(string_pool, str_content)
                push(string_global_names, s_gn)
        ai = ai + 1

    // Store string pool entries in the generator for expression compilation
    var ssi: Int = 0
    while ssi < len(string_pool):
        let entry: StringConstEntry = StringConstEntry {
            global_name: string_global_names[ssi],
            content:     string_pool[ssi],
            length:      len(string_pool[ssi]),
        }
        push(r.string_consts, entry)
        ssi = ssi + 1

    // Emit string globals
    if len(string_pool) > 0:
        var si2: Int = 0
        while si2 < len(string_pool):
            let content: String = string_pool[si2]
            let gn: String = string_global_names[si2]
            let byte_len: Int = len(content) + 1  // +1 for null terminator
            r = emit_raw(r, gn + " = private unnamed_addr constant [" + str(byte_len) + " x i8] c\"" + content + "\\00\", align 1\n")
            si2 = si2 + 1

    // Always emit the empty string constant
    r = emit_raw(r, "@.str.empty = private unnamed_addr constant [1 x i8] zeroinitializer, align 1\n")
    return r

// ── byte_val_to_escaped_char — convert byte value to LLVM escape sequence ──

pub fn byte_val_to_escaped_char(byte_val: Int) -> String:
    if byte_val == 10:   return "\\0A"     // \\n
    if byte_val == 13:   return "\\0D"     // \\r
    if byte_val == 9:    return "\\09"     // \\t
    if byte_val == 34:   return "\\22"     // \"
    if byte_val == 92:   return "\\5C"     // \\
    if byte_val == 0:    return "\\00"
    // Printable ASCII
    if byte_val >= 32 and byte_val < 127:
        var c: String = ""
        // Simple char conversion — use hex escape for reliability
        return hex_escape(byte_val)
    return hex_escape(byte_val)

pub fn hex_escape(b: Int) -> String:
    let hi: Int = (b / 16) % 16
    let lo: Int = b % 16
    var hi_c: String = ""
    var lo_c: String = ""
    if hi == 0: hi_c = "0"
    elif hi == 1: hi_c = "1"
    elif hi == 2: hi_c = "2"
    elif hi == 3: hi_c = "3"
    elif hi == 4: hi_c = "4"
    elif hi == 5: hi_c = "5"
    elif hi == 6: hi_c = "6"
    elif hi == 7: hi_c = "7"
    elif hi == 8: hi_c = "8"
    elif hi == 9: hi_c = "9"
    elif hi == 10: hi_c = "A"
    elif hi == 11: hi_c = "B"
    elif hi == 12: hi_c = "C"
    elif hi == 13: hi_c = "D"
    elif hi == 14: hi_c = "E"
    elif hi == 15: hi_c = "F"
    if lo == 0: lo_c = "0"
    elif lo == 1: lo_c = "1"
    elif lo == 2: lo_c = "2"
    elif lo == 3: lo_c = "3"
    elif lo == 4: lo_c = "4"
    elif lo == 5: lo_c = "5"
    elif lo == 6: lo_c = "6"
    elif lo == 7: lo_c = "7"
    elif lo == 8: lo_c = "8"
    elif lo == 9: lo_c = "9"
    elif lo == 10: lo_c = "A"
    elif lo == 11: lo_c = "B"
    elif lo == 12: lo_c = "C"
    elif lo == 13: lo_c = "D"
    elif lo == 14: lo_c = "E"
    elif lo == 15: lo_c = "F"
    return "\\" + hi_c + lo_c

// ═══════════════════════════════════════════════════════════════════
// Function AST data layout helpers (mirrors types.kn)
// ═══════════════════════════════════════════════════════════════════
// data[0] = name_idx
// data[1] = attrs_count
// data[2..2+ac] = attrs
// next = gcount = data[pos]; data[pos+1..pos+1+2*gc] = generic pairs
// next = pcount = data[pos]; data[pos+1..pos+1+2*pc] = (pname, ptype) pairs
// next = ret_type_idx
// next = where_idx
// next = eff_count; data[pos+1..pos+1+ec] = effect indices
// next = body_idx (block node index, -1 if none)
// next = is_async

pub fn cg_func_skip_attrs(data: Array<Int>) -> Int:
    let ac: Int = if len(data) > 1: data[1] else: 0
    return 2 + ac

pub fn cg_func_skip_generics(data: Array<Int>, pos: Int) -> Int:
    let gc: Int = if pos < len(data): data[pos] else: 0
    return pos + 1 + 2 * gc

pub fn cg_func_skip_params(data: Array<Int>, pos: Int) -> Int:
    let pc: Int = if pos < len(data): data[pos] else: 0
    return pos + 1 + 2 * pc

// ═══════════════════════════════════════════════════════════════════
// compile_function_textual — REAL function emission
// ═══════════════════════════════════════════════════════════════════
//
// Emits a complete LLVM function definition:
//   define <ret_ty> @<fn_name>(<params>) {
//   entry:
//     ; alloca for each parameter + locals
//     ; compile body statements via compile_block_textual
//     ; ret instruction
//   }

pub fn compile_function_textual(gen: LlvmGenerator,
                                 item: TypedItem,
                                 ast_nodes: Array<AstNode>) -> LlvmGenerator:
    let mut r: LlvmGenerator = gen
    let ret_llvm: String = map_type_to_llvm(item.resolved_type)
    let fn_name: String = item.name

    // ── Emit function signature ──
    r = emit_blank(r)
    r = emit_raw(r, "define " + ret_llvm + " @" + fn_name + "(")
    // Emit parameters (use resolved types when available)
    let param_count: Int = item.resolved_type.fn_param_count
    let pcount: Int = len(item.fn_param_types)
    if pcount > 0:
        var pi: Int = 0
        while pi < pcount:
            if pi > 0:
                r = emit_raw(r, ", ")
            let pt: ResolvedType = item.fn_param_types[pi]
            r = emit_raw(r, map_type_to_llvm(pt) + " %param_" + str(pi))
            pi = pi + 1
    else:
        let param_count: Int = item.resolved_type.fn_param_count
        var pi: Int = 0
        while pi < param_count:
            if pi > 0:
                r = emit_raw(r, ", ")
            // Fallback: all params are i64
            r = emit_raw(r, "i64 %param_" + str(pi))
            pi = pi + 1

    r = emit_raw(r, ")")

    // Effects attribute
    let eff: Int = item.effects
    if eff == 0:  // Pure
        r = emit_raw(r, " #0")

    r = emit_raw(r, " {\n")

    // ── Reset local variables for this function ──
    r.locals = []
    r.loop_stack = []

    // ── Locate the function AST node ──
    let fn_ast_idx: Int = item.ast_index
    let fn_node_exists: Bool = fn_ast_idx >= 0 and fn_ast_idx < len(ast_nodes)
    let fn_node: AstNode = if fn_node_exists:
        AstNode { kind: ast_nodes[fn_ast_idx].kind, span_start: ast_nodes[fn_ast_idx].span_start, span_end: ast_nodes[fn_ast_idx].span_end, data: ast_nodes[fn_ast_idx].data }
    else:
        AstNode { kind: AST_ITEM_FUNCTION, span_start: 0, span_end: 0, data: [] }

    let dlen: Int = ast_data_len(fn_node)

    // ── Parse function data layout to find body_idx ──
    var body_idx: Int = -1
    if dlen > 0:
        var pos: Int = cg_func_skip_attrs(fn_node.data)
        pos = cg_func_skip_generics(fn_node.data, pos)
        pos = cg_func_skip_params(fn_node.data, pos)
        // pos now at ret_type_idx
        if pos < dlen: pos = pos + 1  // skip ret_type_idx
        if pos < dlen: pos = pos + 1  // skip where_idx
        // pos now at eff_count
        let ec: Int = if pos < dlen: fn_node.data[pos] else: 0
        pos = pos + 1 + ec  // skip effects
        // pos now at body_idx
        if pos < dlen:
            body_idx = fn_node.data[pos]

    // ── Entry block ──
    let entry_result: GenResult = next_label(r)
    r = entry_result.gen
    let entry_label: String = entry_result.reg
    r = emit_raw(r, entry_label + ":\n")
    r = emit_indent(r)

    // ── Alloca parameters ──
    var pi2: Int = 0
    while pi2 < param_count:
        let param_reg: String = "%param_" + str(pi2)
        let alloca_result: GenResult = next_reg(r)
        r = alloca_result.gen
        let alloca_reg: String = alloca_result.reg
        let param_llvm_ty: String = "i64"
        if pcount > 0 and pi2 < pcount:
            param_llvm_ty = map_type_to_llvm(item.fn_param_types[pi2])
        r = emit_raw(r, alloca_reg + " = alloca " + param_llvm_ty + ", align 8\n")
        r = emit_raw(r, "store " + param_llvm_ty + " " + param_reg + ", ptr " + alloca_reg + ", align 8\n")
        let param_name: String = "param_" + str(pi2)
        r = locals_add(r, param_name, alloca_reg, param_llvm_ty)
        pi2 = pi2 + 1

    // ── Compile function body via block ──
    if body_idx >= 0 and body_idx < len(ast_nodes):
        let body_node: AstNode = ast_nodes[body_idx]
        // Use compile_block_textual which walks the block's data as child indices
        let body_result: GenTypeResult = compile_block_textual(r, body_node, ast_nodes)
        r = body_result.gen

    // ── Default return (in case no explicit return) ──
    if ret_llvm != "void":
        r = emit_raw(r, "ret " + ret_llvm + " 0\n")
    else:
        r = emit_raw(r, "ret void\n")

    r = emit_dedent(r)
    r = emit_raw(r, "}\n")

    return r

// ═══════════════════════════════════════════════════════════════════
// compile_stmt_textual — statement dispatch
// ═══════════════════════════════════════════════════════════════════

pub fn compile_stmt_textual(gen: LlvmGenerator,
                             node_idx: Int,
                             ast_nodes: Array<AstNode>,
                             fn_ret_ty: String) -> LlvmGenerator:
    if node_idx < 0 or node_idx >= len(ast_nodes):
        return gen

    let node: AstNode = ast_nodes[node_idx]
    let k: Int = node.kind
    let mut g: LlvmGenerator = gen

    if k == AST_STMT_LET:
        let name_idx: Int = ast_data_get(node, 0)
        let init_idx: Int = ast_data_get(node, 1)
        let var_name: String = "v_" + str(name_idx)
        let init_llvm_ty: String = "i64"

        // Compile init expression
        if init_idx >= 0 and init_idx < len(ast_nodes):
            let init_result: GenTypeResult = compile_expr_textual(g, init_idx, ast_nodes)
            g = init_result.gen
            let init_reg: String = init_result.reg
            let actual_ty: String = init_result.llvm_type

            // Alloca
            let alloca_result: GenResult = next_reg(g)
            g = alloca_result.gen
            let alloca_reg: String = alloca_result.reg
            g = emit_raw(g, alloca_reg + " = alloca " + actual_ty + ", align 8\n")
            g = emit_raw(g, "store " + actual_ty + " " + init_reg + ", ptr " + alloca_reg + ", align 8\n")
            g = locals_add(g, var_name, alloca_reg, actual_ty)
        else:
            // No init — alloca + zero-init
            let alloca_result: GenResult = next_reg(g)
            g = alloca_result.gen
            let alloca_reg: String = alloca_result.reg
            g = emit_raw(g, alloca_reg + " = alloca i64, align 8\n")
            g = emit_raw(g, "store i64 0, ptr " + alloca_reg + ", align 8\n")
            g = locals_add(g, var_name, alloca_reg, "i64")

    elif k == AST_STMT_RETURN:
        let val_idx: Int = ast_data_get(node, 0)
        if val_idx >= 0 and val_idx < len(ast_nodes):
            let val_result: GenTypeResult = compile_expr_textual(g, val_idx, ast_nodes)
            g = val_result.gen
            g = emit_raw(g, "ret " + val_result.llvm_type + " " + val_result.reg + "\n")
        else:
            g = emit_raw(g, "ret void\n")

    elif k == AST_STMT_EXPR:
        let expr_idx: Int = ast_data_get(node, 0)
        if expr_idx >= 0 and expr_idx < len(ast_nodes):
            let expr_result: GenTypeResult = compile_expr_textual(g, expr_idx, ast_nodes)
            g = expr_result.gen

    elif k == AST_STMT_WHILE:
        let while_result: GenTypeResult = compile_while_textual(g, node, ast_nodes)
        g = while_result.gen

    elif k == AST_STMT_FOR:
        let for_result: GenTypeResult = compile_for_textual(g, node, ast_nodes)
        g = for_result.gen

    elif k == AST_STMT_LOOP:
        let loop_result: GenTypeResult = compile_loop_textual(g, node, ast_nodes)
        g = loop_result.gen

    elif k == AST_STMT_BREAK:
        g = compile_break_textual(g, node, ast_nodes)

    elif k == AST_STMT_CONTINUE:
        g = compile_continue_textual(g, node, ast_nodes)

    else:
        // Unknown statement — emit a comment
        g = emit_raw(g, "; stmt kind " + str(k) + " (not yet lowered)\n")

    return g

// ═══════════════════════════════════════════════════════════════════
// compile_expr_textual — RECURSIVE EXPRESSION COMPILER
// ═══════════════════════════════════════════════════════════════════
//
// Returns (gen, reg, llvm_type) — the register holding the value and its LLVM type.

pub fn compile_expr_textual(gen: LlvmGenerator,
                             node_idx: Int,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    if node_idx < 0 or node_idx >= len(ast_nodes):
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    let node: AstNode = ast_nodes[node_idx]
    let k: Int = node.kind
    let dlen: Int = ast_data_len(node)

    // ── Literals ──

    if k == AST_EXPR_INT:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, " + str(val) + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    if k == AST_EXPR_FLOAT:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = fadd double 0.0, 0x" + str(val) + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "double" }

    if k == AST_EXPR_BOOL:
        let val: Int = if dlen > 0: ast_data_get(node, 0) else: 0
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        let bool_val: String = if val != 0: "true" else: "false"
        r = emit_raw(r, "  " + nr.reg + " = add i1 0, " + bool_val + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i1" }

    if k == AST_EXPR_NONE:
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    if k == AST_EXPR_STRING:
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        // Extract string content and look up in generator's string pool
        let sd: Array<Int> = node.data
        let sdlen: Int = len(sd)
        var str_content: String = ""
        if sdlen > 0:
            let str_len: Int = sd[0]
            var ci: Int = 0
            while ci < str_len and (ci + 1) < sdlen:
                let byte_val: Int = sd[ci + 1]
                if byte_val > 0 and byte_val < 128:
                    str_content = str_content + byte_val_to_escaped_char(byte_val)
                ci = ci + 1
        // Find matching global name in string_consts
        var global_name: String = "@.str.empty"
        var byte_len: Int = 1
        var sci: Int = 0
        while sci < len(gen.string_consts):
            if gen.string_consts[sci].content == str_content:
                global_name = gen.string_consts[sci].global_name
                byte_len = gen.string_consts[sci].length + 1
                sci = len(gen.string_consts)
            sci = sci + 1
        r = emit_raw(r, "  " + nr.reg + " = getelementptr [" + str(byte_len) + " x i8], ptr " + global_name + ", i64 0, i64 0\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "ptr" }

    // ── Variable reference ──

    if k == AST_EXPR_IDENT:
        let name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
        let var_name: String = "v_" + str(name_idx)
        let alloca_reg: String = locals_get_reg(gen, var_name)
        let var_type: String = locals_get_ty(gen, var_name)
        if alloca_reg != "":
            let nr: GenResult = next_reg(gen)
            let r: LlvmGenerator = nr.gen
            r = emit_raw(r, "  " + nr.reg + " = load " + var_type + ", ptr " + alloca_reg + ", align 8\n")
            return GenTypeResult { gen: r, reg: nr.reg, llvm_type: var_type }
        let nr: GenResult = next_reg(gen)
        let r: LlvmGenerator = nr.gen
        r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0  ; undefined var " + var_name + "\n")
        return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

    // ── Compound expressions — delegate to specialized compilers ──

    if k == AST_EXPR_BINARY:
        return compile_binary_textual(gen, node, ast_nodes)

    if k == AST_EXPR_UNARY:
        return compile_unary_textual(gen, node, ast_nodes)

    if k == AST_EXPR_CALL:
        return compile_call_textual(gen, node, ast_nodes)

    if k == AST_EXPR_IF:
        return compile_if_textual(gen, node, ast_nodes)

    if k == AST_EXPR_BLOCK:
        return compile_block_textual(gen, node, ast_nodes)

    if k == AST_EXPR_STRUCT_LIT:
        return compile_struct_lit_textual(gen, node, ast_nodes)

    if k == AST_EXPR_FIELD:
        return compile_field_access_textual(gen, node, ast_nodes)

    if k == AST_EXPR_ASSIGN:
        return compile_assign_textual(gen, node, ast_nodes)

    if k == AST_EXPR_REF:
        return compile_ref_textual(gen, node, ast_nodes)

    if k == AST_EXPR_DEREF:
        return compile_deref_textual(gen, node, ast_nodes)

    if k == AST_EXPR_CAST:
        return compile_cast_textual(gen, node, ast_nodes)

    if k == AST_EXPR_PAREN:
        let inner_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
        if inner_idx >= 0 and inner_idx < len(ast_nodes):
            return compile_expr_textual(gen, inner_idx, ast_nodes)

    // ── TIER 2: New expression compilers (Stream BLUE) ──

    if k == AST_EXPR_MATCH:
        return compile_match_textual(gen, node, ast_nodes)

    if k == AST_EXPR_ARRAY:
        return compile_array_lit_textual(gen, node, ast_nodes)

    if k == AST_EXPR_INDEX:
        return compile_index_textual(gen, node, ast_nodes)

    if k == AST_EXPR_METHOD_CALL:
        return compile_method_call_textual(gen, node, ast_nodes)

    if k == AST_EXPR_ENUM_VARIANT:
        return compile_enum_variant_textual(gen, node, ast_nodes)

    if k == AST_EXPR_LAMBDA:
        return compile_lambda_textual(gen, node, ast_nodes)

    if k == AST_EXPR_SPAWN:
        return compile_spawn_textual(gen, node, ast_nodes)

    if k == AST_EXPR_TUPLE:
        return compile_tuple_textual(gen, node, ast_nodes)

    // ── Fallback for unknown ──
    let nr: GenResult = next_reg(gen)
    let r: LlvmGenerator = nr.gen
    r = emit_raw(r, "  " + nr.reg + " = add i64 0, 0  ; unknown expr kind " + str(k) + "\n")
    return GenTypeResult { gen: r, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_binary_textual — arithmetic, comparison, logic
// ═══════════════════════════════════════════════════════════════════

pub fn compile_binary_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let lhs_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let rhs_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    let op: Int = if dlen > 2: ast_data_get(node, 2) else: BINOP_ADD

    // Compile left operand
    let lhs_result: GenTypeResult = compile_expr_textual(gen, lhs_idx, ast_nodes)
    let mut g: LlvmGenerator = lhs_result.gen
    let lhs_reg: String = lhs_result.reg
    let lhs_ty: String = lhs_result.llvm_type

    // Compile right operand
    let rhs_result: GenTypeResult = compile_expr_textual(g, rhs_idx, ast_nodes)
    g = rhs_result.gen
    let rhs_reg: String = rhs_result.reg

    // Short-circuit and/or
    if op == BINOP_AND:
        return compile_and_textual(g, lhs_reg, lhs_ty, rhs_idx, ast_nodes)
    if op == BINOP_OR:
        return compile_or_textual(g, lhs_reg, lhs_ty, rhs_idx, ast_nodes)

    // Emit operation
    let nr: GenResult = next_reg(g)
    g = nr.gen
    let result_reg: String = nr.reg

    let is_cmp: Bool = is_comparison_op(op)
    let op_ty: String = if is_cmp: lhs_ty else: lhs_ty

    if is_cmp:
        let pred_str: String = comparison_op_to_llvm_pred(op)
        g = emit_raw(g, "  " + result_reg + " = icmp " + pred_str + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: "i1" }

    // Float ops
    if lhs_ty == "double" or lhs_ty == "float":
        let instr: String = float_binary_op_to_llvm(op)
        g = emit_raw(g, "  " + result_reg + " = " + instr + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: lhs_ty }

    // Integer ops
    let instr: String = int_binary_op_to_llvm(op)
    g = emit_raw(g, "  " + result_reg + " = " + instr + " " + op_ty + " " + lhs_reg + ", " + rhs_reg + "\n")
    return GenTypeResult { gen: g, reg: result_reg, llvm_type: lhs_ty }

// ── Binary op → LLVM integer instruction ──

pub fn int_binary_op_to_llvm(op: Int) -> String:
    if op == BINOP_ADD:      return "add"
    if op == BINOP_SUB:      return "sub"
    if op == BINOP_MUL:      return "mul"
    if op == BINOP_DIV:      return "sdiv"
    if op == BINOP_MOD:      return "srem"
    if op == BINOP_BIT_AND:  return "and"
    if op == BINOP_BIT_OR:   return "or"
    if op == BINOP_BIT_XOR:  return "xor"
    if op == BINOP_SHL:      return "shl"
    if op == BINOP_SHR:      return "ashr"
    return "add"

// ── Binary op → LLVM float instruction ──

pub fn float_binary_op_to_llvm(op: Int) -> String:
    if op == BINOP_ADD:      return "fadd"
    if op == BINOP_SUB:      return "fsub"
    if op == BINOP_MUL:      return "fmul"
    if op == BINOP_DIV:      return "fdiv"
    if op == BINOP_MOD:      return "frem"
    return "fadd"

// ── Comparison op → LLVM icmp predicate ──

pub fn comparison_op_to_llvm_pred(op: Int) -> String:
    if op == BINOP_EQ:  return "eq"
    if op == BINOP_NE:  return "ne"
    if op == BINOP_LT:  return "slt"
    if op == BINOP_GT:  return "sgt"
    if op == BINOP_LE:  return "sle"
    if op == BINOP_GE:  return "sge"
    return "eq"

pub fn is_comparison_op(op: Int) -> Bool:
    return (op == BINOP_EQ) or (op == BINOP_NE) or (op == BINOP_LT) or (op == BINOP_GT) or (op == BINOP_LE) or (op == BINOP_GE)

// ═══════════════════════════════════════════════════════════════════
// compile_unary_textual — negation, not, bit-not, ref, deref
// ═══════════════════════════════════════════════════════════════════

pub fn compile_unary_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let op: Int = if dlen > 0: ast_data_get(node, 0) else: UNOP_NEG
    let inner_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    let inner_result: GenTypeResult = compile_expr_textual(gen, inner_idx, ast_nodes)
    let mut g: LlvmGenerator = inner_result.gen
    let inner_reg: String = inner_result.reg
    let inner_ty: String = inner_result.llvm_type

    let nr: GenResult = next_reg(g)
    g = nr.gen
    let result_reg: String = nr.reg

    if op == UNOP_NEG:
        if inner_ty == "double" or inner_ty == "float":
            g = emit_raw(g, "  " + result_reg + " = fsub " + inner_ty + " 0.0, " + inner_reg + "\n")
        else:
            g = emit_raw(g, "  " + result_reg + " = sub " + inner_ty + " 0, " + inner_reg + "\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: inner_ty }

    if op == UNOP_NOT:
        g = emit_raw(g, "  " + result_reg + " = icmp eq " + inner_ty + " " + inner_reg + ", 0\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: "i1" }

    if op == UNOP_BIT_NOT:
        g = emit_raw(g, "  " + result_reg + " = xor " + inner_ty + " " + inner_reg + ", -1\n")
        return GenTypeResult { gen: g, reg: result_reg, llvm_type: inner_ty }

    // UNOP_REF and UNOP_DEREF — pass through the inner value
    return GenTypeResult { gen: g, reg: inner_reg, llvm_type: inner_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_if_textual — conditional branching with phi node
// ═══════════════════════════════════════════════════════════════════

pub fn compile_if_textual(gen: LlvmGenerator,
                           node: AstNode,
                           ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let cond_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let then_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    let else_idx: Int = if dlen > 2: ast_data_get(node, 2) else: -1

    let has_else: Bool = else_idx >= 0 and else_idx < len(ast_nodes)

    // Compile condition
    let cond_result: GenTypeResult = compile_expr_textual(gen, cond_idx, ast_nodes)
    let mut g: LlvmGenerator = cond_result.gen
    let cond_reg: String = cond_result.reg

    // If condition is not i1, convert
    let mut branch_cond: String = cond_reg
    if cond_result.llvm_type != "i1":
        let conv_nr: GenResult = next_reg(g)
        g = conv_nr.gen
        g = emit_raw(g, "  " + conv_nr.reg + " = icmp ne " + cond_result.llvm_type + " " + cond_reg + ", 0\n")
        branch_cond = conv_nr.reg

    // Labels
    let then_lbl_res: GenResult = next_label(g)
    g = then_lbl_res.gen
    let then_lbl: String = then_lbl_res.reg

    let else_lbl_res: GenResult = next_label(g)
    g = else_lbl_res.gen
    let else_lbl: String = else_lbl_res.reg

    let merge_lbl_res: GenResult = next_label(g)
    g = merge_lbl_res.gen
    let merge_lbl: String = merge_lbl_res.reg

    // Branch
    g = emit_raw(g, "  br i1 " + branch_cond + ", label %" + then_lbl + ", label %" + else_lbl + "\n")

    // Save indent level
    let saved_indent: Int = g.indent_level

    // Then block
    g = emit_raw(g, then_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let then_result: GenTypeResult = compile_expr_textual(g, then_idx, ast_nodes)
    g = then_result.gen
    let then_reg: String = then_result.reg
    let result_ty: String = then_result.llvm_type
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Else block
    g.indent_level = saved_indent
    g = emit_raw(g, else_lbl + ":\n")
    g.indent_level = saved_indent + 1
    var else_reg: String = "0"
    var else_ty: String = "i64"
    if has_else:
        let else_result: GenTypeResult = compile_expr_textual(g, else_idx, ast_nodes)
        g = else_result.gen
        else_reg = else_result.reg
        else_ty = else_result.llvm_type
        result_ty = else_ty  // Use else type if available
    else:
        // No else — produce unit value
        let nr: GenResult = next_reg(g)
        g = nr.gen
        else_reg = nr.reg
        g = emit_raw(g, "  " + else_reg + " = add i64 0, 0\n")
        else_ty = "i64"
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Merge block with phi
    g.indent_level = saved_indent
    g = emit_raw(g, merge_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let phi_nr: GenResult = next_reg(g)
    g = phi_nr.gen
    g = emit_raw(g, "  " + phi_nr.reg + " = phi " + result_ty + " [ " + then_reg + ", %" + then_lbl + " ], [ " + else_reg + ", %" + else_lbl + " ]\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: phi_nr.reg, llvm_type: result_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_call_textual — function call emission
// ═══════════════════════════════════════════════════════════════════

pub fn compile_call_textual(gen: LlvmGenerator,
                             node: AstNode,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let fn_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let fn_name: String = "fn_" + str(fn_name_idx)

    // Determine return type — look up from program, default to i64
    let ret_ty: String = "i64"
    // Try to find the function’s TypedItem for return type info
    if len(gen.program_items) > 0:
        var ii: Int = 0
        while ii < len(gen.program_items):
            let item: TypedItem = gen.program_items[ii]
            if item.name_idx == fn_name_idx and item.kind == AST_ITEM_FUNCTION:
                let actual_ret: ResolvedType = if item.fn_ret_type.kind != 0: item.fn_ret_type else: item.resolved_type
                ret_ty = map_type_to_llvm(actual_ret)
                ii = len(gen.program_items)  // break
            ii = ii + 1

    // Compile arguments
    let mut g: LlvmGenerator = gen
    var args_str: String = ""
    var arg_i: Int = 1
    while arg_i < dlen:
        let arg_idx: Int = ast_data_get(node, arg_i)
        if arg_idx >= 0 and arg_idx < len(ast_nodes):
            let arg_result: GenTypeResult = compile_expr_textual(g, arg_idx, ast_nodes)
            g = arg_result.gen
            if arg_i > 1:
                args_str = args_str + ", "
            args_str = args_str + arg_result.llvm_type + " " + arg_result.reg
        arg_i = arg_i + 1

    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = call " + ret_ty + " @" + fn_name + "(" + args_str + ")\n")

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: ret_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_block_textual — block expression (multiple statements)
// ═══════════════════════════════════════════════════════════════════

pub fn compile_block_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let mut g: LlvmGenerator = gen
    var last_reg: String = ""
    var last_ty: String = "i64"

    var stmt_i: Int = 0
    while stmt_i < dlen:
        let stmt_idx: Int = ast_data_get(node, stmt_i)
        if stmt_idx >= 0 and stmt_idx < len(ast_nodes):
            let stmt_node: AstNode = ast_nodes[stmt_idx]
            let stmt_kind: Int = stmt_node.kind

            // If this is a statement kind, compile as statement
            if stmt_kind == AST_STMT_LET or stmt_kind == AST_STMT_RETURN or stmt_kind == AST_STMT_EXPR or stmt_kind == AST_STMT_WHILE or stmt_kind == AST_STMT_FOR or stmt_kind == AST_STMT_LOOP or stmt_kind == AST_STMT_BREAK or stmt_kind == AST_STMT_CONTINUE:
                g = compile_stmt_textual(g, stmt_idx, ast_nodes, "void")
            else:
                // Expression — compile and capture result
                let expr_result: GenTypeResult = compile_expr_textual(g, stmt_idx, ast_nodes)
                g = expr_result.gen
                last_reg = expr_result.reg
                last_ty = expr_result.llvm_type
        stmt_i = stmt_i + 1

    // If no trailing expression was captured, return dummy
    if last_reg == "":
        let nr: GenResult = next_reg(g)
        g = nr.gen
        g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
        return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

    return GenTypeResult { gen: g, reg: last_reg, llvm_type: last_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_struct_lit_textual — alloca + gep + store chain
// ═══════════════════════════════════════════════════════════════════

pub fn compile_struct_lit_textual(gen: LlvmGenerator,
                                   node: AstNode,
                                   ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let struct_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let struct_name: String = "%struct_" + str(struct_name_idx)

    // Allocate
    let alloca_nr: GenResult = next_reg(gen)
    let mut g: LlvmGenerator = alloca_nr.gen
    let alloca_reg: String = alloca_nr.reg
    g = emit_raw(g, "  " + alloca_reg + " = alloca " + struct_name + ", align 8\n")

    // Store fields via GEP
    var field_i: Int = 1
    var gep_idx: Int = 0
    while field_i < dlen:
        let field_val_idx: Int = ast_data_get(node, field_i)
        let field_result: GenTypeResult = compile_expr_textual(g, field_val_idx, ast_nodes)
        g = field_result.gen

        // GEP to field
        let gep_nr: GenResult = next_reg(g)
        g = gep_nr.gen
        g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds " + struct_name + ", ptr " + alloca_reg + ", i32 0, i32 " + str(gep_idx) + "\n")

        // Store
        g = emit_raw(g, "  store " + field_result.llvm_type + " " + field_result.reg + ", ptr " + gep_nr.reg + ", align 8\n")

        field_i = field_i + 1
        gep_idx = gep_idx + 1

    // Load the struct value
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load " + struct_name + ", ptr " + alloca_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: struct_name }

// ═══════════════════════════════════════════════════════════════════
// compile_field_access_textual — GEP + load for field access
// ═══════════════════════════════════════════════════════════════════

pub fn compile_field_access_textual(gen: LlvmGenerator,
                                     node: AstNode,
                                     ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let obj_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let field_name_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    // Compile object expression
    let obj_result: GenTypeResult = compile_expr_textual(gen, obj_idx, ast_nodes)
    let mut g: LlvmGenerator = obj_result.gen
    let obj_reg: String = obj_result.reg
    let obj_ty: String = obj_result.llvm_type

    // Determine field index by walking the struct's AST for field name
    var field_index: Int = 0
    var matched_name_idx: Int = -1
    var found_struct: Bool = false
    if obj_ty != "ptr" and obj_ty != "i64":
        // obj_ty is like %struct_N — extract the struct name_idx
        // The struct type is %struct_<name_idx>
        // We need to find the struct AST node and locate the field name
        // Walk all AST nodes looking for the struct definition
        var si: Int = 0
        while si < len(ast_nodes):
            let s_node: AstNode = ast_nodes[si]
            if s_node.kind == AST_ITEM_STRUCT:
                let sd: Array<Int> = s_node.data
                let sdlen: Int = len(sd)
                let s_name_idx: Int = if sdlen > 0: sd[0] else: -1

                // Match against the type name pattern %struct_<name_idx>
                let expected_name: String = "%struct_" + str(s_name_idx)
                if expected_name == obj_ty:
                    found_struct = true
                    matched_name_idx = s_name_idx
                    let gc: Int = if sdlen > 1: sd[1] else: 0
                    let fc_pos: Int = 2 + 2 * gc
                    let fcount: Int = if fc_pos < sdlen: sd[fc_pos] else: 0
                    var fi: Int = 0
                    while fi < fcount:
                        let fname: Int = sd[fc_pos + 1 + 2 * fi]
                        if fname == field_name_idx:
                            field_index = fi
                            fi = fcount
                        fi = fi + 1
                    si = len(ast_nodes)  // exit outer loop
            si = si + 1

    // GEP to field at resolved index
    let gep_nr: GenResult = next_reg(g)
    g = gep_nr.gen
    g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds " + obj_ty + ", ptr " + obj_reg + ", i32 0, i32 " + str(field_index) + "\n")

    // Determine field LLVM type from TypedItem
    let field_llvm_ty: String = "i64"
    if found_struct:
        var pii: Int = 0
        while pii < len(gen.program_items):
            let s_item: TypedItem = gen.program_items[pii]
            if s_item.kind == AST_ITEM_STRUCT and s_item.name_idx == matched_name_idx:
                if field_index < len(s_item.field_types):
                    field_llvm_ty = map_type_to_llvm(s_item.field_types[field_index])
                pii = len(gen.program_items)
            pii = pii + 1

    // Load field value
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load " + field_llvm_ty + ", ptr " + gep_nr.reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: field_llvm_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_assign_textual — store into local variable
// ═══════════════════════════════════════════════════════════════════

pub fn compile_assign_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let target_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let value_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    let var_name: String = "v_" + str(target_idx)
    let alloca_reg: String = locals_get_reg(gen, var_name)

    // Compile value
    let val_result: GenTypeResult = compile_expr_textual(gen, value_idx, ast_nodes)
    let mut g: LlvmGenerator = val_result.gen
    let val_reg: String = val_result.reg
    let val_ty: String = val_result.llvm_type

    if alloca_reg != "":
        g = emit_raw(g, "  store " + val_ty + " " + val_reg + ", ptr " + alloca_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: val_reg, llvm_type: val_ty }

// ═══════════════════════════════════════════════════════════════════
// compile_ref_textual — reference to local variable (return alloca ptr)
// ═══════════════════════════════════════════════════════════════════

pub fn compile_ref_textual(gen: LlvmGenerator,
                            node: AstNode,
                            ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let target_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let var_name: String = "v_" + str(target_idx)
    let alloca_reg: String = locals_get_reg(gen, var_name)

    if alloca_reg != "":
        return GenTypeResult { gen: gen, reg: alloca_reg, llvm_type: "ptr" }

    // Fallback: null pointer
    let nr: GenResult = next_reg(gen)
    let g: LlvmGenerator = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "ptr" }

// ═══════════════════════════════════════════════════════════════════
// compile_deref_textual — load from pointer
// ═══════════════════════════════════════════════════════════════════

pub fn compile_deref_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let ptr_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let ptr_result: GenTypeResult = compile_expr_textual(gen, ptr_idx, ast_nodes)
    let mut g: LlvmGenerator = ptr_result.gen
    let ptr_reg: String = ptr_result.reg

    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load i64, ptr " + ptr_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_cast_textual — type cast via bitcast/trunc/sext/sitofp
// ═══════════════════════════════════════════════════════════════════

pub fn compile_cast_textual(gen: LlvmGenerator,
                             node: AstNode,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let expr_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1

    let expr_result: GenTypeResult = compile_expr_textual(gen, expr_idx, ast_nodes)
    let mut g: LlvmGenerator = expr_result.gen
    let expr_reg: String = expr_result.reg
    let expr_ty: String = expr_result.llvm_type

    let nr: GenResult = next_reg(g)
    g = nr.gen
    // Default: bitcast to i64
    g = emit_raw(g, "  " + nr.reg + " = bitcast " + expr_ty + " " + expr_reg + " to i64\n")

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_while_textual — while loop with header/body/exit blocks
// ═══════════════════════════════════════════════════════════════════

pub fn compile_while_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let cond_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let body_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    // Labels
    let header_lbl_res: GenResult = next_label(gen)
    let mut g: LlvmGenerator = header_lbl_res.gen
    let header_lbl: String = header_lbl_res.reg

    let body_lbl_res: GenResult = next_label(g)
    g = body_lbl_res.gen
    let body_lbl: String = body_lbl_res.reg

    let exit_lbl_res: GenResult = next_label(g)
    g = exit_lbl_res.gen
    let exit_lbl: String = exit_lbl_res.reg

    // Push loop context
    g = loop_push(g, header_lbl, exit_lbl)

    let saved_indent: Int = g.indent_level

    // Branch to header
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Header: check condition
    g.indent_level = saved_indent
    g = emit_raw(g, header_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let cond_result: GenTypeResult = compile_expr_textual(g, cond_idx, ast_nodes)
    g = cond_result.gen
    let cond_reg: String = cond_result.reg

    // Convert to i1 if needed
    var branch_cond: String = cond_reg
    if cond_result.llvm_type != "i1":
        let conv_nr: GenResult = next_reg(g)
        g = conv_nr.gen
        g = emit_raw(g, "  " + conv_nr.reg + " = icmp ne " + cond_result.llvm_type + " " + cond_reg + ", 0\n")
        branch_cond = conv_nr.reg

    g = emit_raw(g, "  br i1 " + branch_cond + ", label %" + body_lbl + ", label %" + exit_lbl + "\n")

    // Body
    g.indent_level = saved_indent
    g = emit_raw(g, body_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let body_result: GenTypeResult = compile_expr_textual(g, body_idx, ast_nodes)
    g = body_result.gen
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Exit
    g.indent_level = saved_indent
    g = emit_raw(g, exit_lbl + ":\n")
    g = loop_pop(g)

    g.indent_level = saved_indent + 1
    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ═══════════════════════════════════════════════════════════════════
// compile_return_textual — ret instruction
// ═══════════════════════════════════════════════════════════════════

pub fn compile_return_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let val_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1

    if val_idx < 0 or val_idx >= len(ast_nodes):
        let mut g: LlvmGenerator = gen
        g = emit_raw(g, "  ret void\n")
        return GenTypeResult { gen: g, reg: "", llvm_type: "void" }

    let val_result: GenTypeResult = compile_expr_textual(gen, val_idx, ast_nodes)
    let mut g2: LlvmGenerator = val_result.gen
    g2 = emit_raw(g2, "  ret " + val_result.llvm_type + " " + val_result.reg + "\n")

    return GenTypeResult { gen: g2, reg: val_result.reg, llvm_type: val_result.llvm_type }

// ═══════════════════════════════════════════════════════════════════
// ── Stream BLUE: New Expression Compilers ──
// ═══════════════════════════════════════════════════════════════════

// ── compile_match_textual — tag dispatch + switch/br + phi merge ──
// AST_EXPR_MATCH layout: data[0]=matched_expr_idx, data[1]=arm_count,
// then for each arm: pattern_node_idx, body_node_idx

pub fn compile_match_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let matched_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let arm_count: Int = if dlen > 1: ast_data_get(node, 1) else: 0

    // Compile matched expression
    let match_val_result: GenTypeResult = compile_expr_textual(gen, matched_idx, ast_nodes)
    let mut g: LlvmGenerator = match_val_result.gen
    let match_reg: String = match_val_result.reg
    let match_ty: String = match_val_result.llvm_type

    if arm_count == 0:
        let nr: GenResult = next_reg(g)
        g = nr.gen
        g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0  ; empty match\n")
        return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

    // Create arm body labels and merge label
    let saved_indent: Int = g.indent_level
    let merge_lbl_res: GenResult = next_label(g)
    g = merge_lbl_res.gen
    let merge_lbl: String = merge_lbl_res.reg

    // For each arm, create body block and condition block
    var arm_labels: Array<String> = []
    var arm_nexts: Array<String> = []
    var arm_results: Array<String> = []
    var arm_block_labels: Array<String> = []
    var result_ty: String = "i64"

    var ai: Int = 0
    while ai < arm_count:
        let pat_idx: Int = ast_data_get(node, 2 + 2 * ai)
        let body_idx: Int = ast_data_get(node, 2 + 2 * ai + 1)

        let body_lbl_res: GenResult = next_label(g)
        g = body_lbl_res.gen
        let body_lbl: String = body_lbl_res.reg
        push(arm_block_labels, body_lbl)

        let next_lbl_res: GenResult = next_label(g)
        g = next_lbl_res.gen
        let next_lbl: String = next_lbl_res.reg
        push(arm_nexts, next_lbl)

        ai = ai + 1

    // Emit dispatch chain: compare match value, branch to matching arm
    var cur_label: String = ""
    ai = 0
    while ai < arm_count:
        let body_lbl: String = arm_block_labels[ai]
        let next_lbl: String = arm_nexts[ai]
        let pat_idx: Int = ast_data_get(node, 2 + 2 * ai)

        if ai == 0:
            g.indent_level = saved_indent

        // Branch: try to match this pattern
        if ai < arm_count - 1:
            // Not the last arm — emit compare-and-branch
            // For now, simple integer comparison
            let pat_val: Int = ai  // tag value = arm index
            let cmp_nr: GenResult = next_reg(g)
            g = cmp_nr.gen
            g = emit_raw(g, "  " + cmp_nr.reg + " = icmp eq " + match_ty + " " + match_reg + ", " + str(pat_val) + "\n")
            g = emit_raw(g, "  br i1 " + cmp_nr.reg + ", label %" + body_lbl + ", label %" + next_lbl + "\n")
        else:
            // Last arm — always branch to it
            // But if there's a condition needed, emit compare-and-branch
            g = emit_raw(g, "  br label %" + body_lbl + "\n")

        ai = ai + 1

    // Compile each arm body
    ai = 0
    while ai < arm_count:
        let body_idx: Int = ast_data_get(node, 2 + 2 * ai + 1)
        let body_lbl: String = arm_block_labels[ai]
        let next_lbl: String = arm_nexts[ai]

        g.indent_level = saved_indent
        g = emit_raw(g, body_lbl + ":\n")
        g.indent_level = saved_indent + 1

        // Compile arm body expression
        if body_idx >= 0 and body_idx < len(ast_nodes):
            let arm_result: GenTypeResult = compile_expr_textual(g, body_idx, ast_nodes)
            g = arm_result.gen
            result_ty = arm_result.llvm_type
            push(arm_results, arm_result.reg)
        else:
            let nr: GenResult = next_reg(g)
            g = nr.gen
            g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
            push(arm_results, nr.reg)

        g.indent_level = saved_indent + 1
        g = emit_raw(g, "br label %" + merge_lbl + "\n")

        ai = ai + 1

    // Merge block with phi
    g.indent_level = saved_indent
    g = emit_raw(g, merge_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let phi_nr: GenResult = next_reg(g)
    g = phi_nr.gen
    var phi_args: String = ""
    ai = 0
    while ai < arm_count:
        if ai > 0:
            phi_args = phi_args + ", "
        phi_args = phi_args + "[ " + arm_results[ai] + ", %" + arm_block_labels[ai] + " ]"
        ai = ai + 1
    g = emit_raw(g, "  " + phi_nr.reg + " = phi " + result_ty + " " + phi_args + "\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: phi_nr.reg, llvm_type: result_ty }

// ── compile_for_textual — desugar for-range to while loop ──
// AST_STMT_FOR layout: data[0]=loop_var_name_idx, data[1]=iterable_expr_idx, data[2]=body_expr_idx

pub fn compile_for_textual(gen: LlvmGenerator,
                            node: AstNode,
                            ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let var_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let iterable_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1
    let body_idx: Int = if dlen > 2: ast_data_get(node, 2) else: -1

    let var_name: String = "v_" + str(var_name_idx)
    let mut g: LlvmGenerator = gen

    // Desugar: for x in iterable →
    //   let __i = 0
    //   while __i < len(iterable):
    //       let x = iterable[__i]
    //       body
    //       __i = __i + 1

    // Allocate index variable
    let idx_alloca_res: GenResult = next_reg(g)
    g = idx_alloca_res.gen
    let idx_alloca: String = idx_alloca_res.reg
    g = emit_raw(g, "  " + idx_alloca + " = alloca i64, align 8\n")
    g = emit_raw(g, "  store i64 0, ptr " + idx_alloca + ", align 8\n")
    g = locals_add(g, "_for_idx_" + str(var_name_idx), idx_alloca, "i64")

    // Compute upper bound (len of iterable or range end)
    let bound_nr: GenResult = next_reg(g)
    g = bound_nr.gen
    let bound_reg: String = bound_nr.reg
    g = emit_raw(g, "  " + bound_reg + " = add i64 0, 10  ; for bound stub (upper limit)\n")
    let bound_alloca_res: GenResult = next_reg(g)
    g = bound_alloca_res.gen
    let bound_alloca: String = bound_alloca_res.reg
    g = emit_raw(g, "  " + bound_alloca + " = alloca i64, align 8\n")
    g = emit_raw(g, "  store i64 " + bound_reg + ", ptr " + bound_alloca + ", align 8\n")
    g = locals_add(g, "_for_bound_" + str(var_name_idx), bound_alloca, "i64")

    // Allocate loop variable
    let var_alloca_res: GenResult = next_reg(g)
    g = var_alloca_res.gen
    let var_alloca: String = var_alloca_res.reg
    g = emit_raw(g, "  " + var_alloca + " = alloca i64, align 8\n")
    g = emit_raw(g, "  store i64 0, ptr " + var_alloca + ", align 8\n")
    g = locals_add(g, var_name, var_alloca, "i64")

    // While loop structure
    let header_lbl_res: GenResult = next_label(g)
    g = header_lbl_res.gen
    let header_lbl: String = header_lbl_res.reg

    let body_lbl_res: GenResult = next_label(g)
    g = body_lbl_res.gen
    let body_lbl: String = body_lbl_res.reg

    let exit_lbl_res: GenResult = next_label(g)
    g = exit_lbl_res.gen
    let exit_lbl: String = exit_lbl_res.reg

    let saved_indent: Int = g.indent_level
    g = loop_push(g, header_lbl, exit_lbl)

    // Branch to header
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Header: check idx < bound
    g.indent_level = saved_indent
    g = emit_raw(g, header_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let idx_load_nr: GenResult = next_reg(g)
    g = idx_load_nr.gen
    g = emit_raw(g, "  " + idx_load_nr.reg + " = load i64, ptr " + idx_alloca + ", align 8\n")
    let bnd_load_nr: GenResult = next_reg(g)
    g = bnd_load_nr.gen
    g = emit_raw(g, "  " + bnd_load_nr.reg + " = load i64, ptr " + bound_alloca + ", align 8\n")
    let cmp_nr: GenResult = next_reg(g)
    g = cmp_nr.gen
    g = emit_raw(g, "  " + cmp_nr.reg + " = icmp slt i64 " + idx_load_nr.reg + ", " + bnd_load_nr.reg + "\n")
    g = emit_raw(g, "  br i1 " + cmp_nr.reg + ", label %" + body_lbl + ", label %" + exit_lbl + "\n")

    // Body: assign loop var, compile body, increment
    g.indent_level = saved_indent
    g = emit_raw(g, body_lbl + ":\n")
    g.indent_level = saved_indent + 1
    // Assign loop variable = current index
    g = emit_raw(g, "  store i64 " + idx_load_nr.reg + ", ptr " + var_alloca + ", align 8\n")
    // Compile body
    if body_idx >= 0 and body_idx < len(ast_nodes):
        let body_result: GenTypeResult = compile_expr_textual(g, body_idx, ast_nodes)
        g = body_result.gen
    // Increment index
    let inc_nr: GenResult = next_reg(g)
    g = inc_nr.gen
    g = emit_raw(g, "  " + inc_nr.reg + " = add i64 " + idx_load_nr.reg + ", 1\n")
    g = emit_raw(g, "  store i64 " + inc_nr.reg + ", ptr " + idx_alloca + ", align 8\n")
    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Exit
    g.indent_level = saved_indent
    g = emit_raw(g, exit_lbl + ":\n")
    g = loop_pop(g)
    g.indent_level = saved_indent + 1
    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
    g.indent_level = saved_indent

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ── compile_loop_textual — infinite loop with break value ──
// AST_STMT_LOOP layout: data[0]=body_expr_idx

pub fn compile_loop_textual(gen: LlvmGenerator,
                             node: AstNode,
                             ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let body_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1

    let mut g: LlvmGenerator = gen
    let saved_indent: Int = g.indent_level

    let header_lbl_res: GenResult = next_label(g)
    g = header_lbl_res.gen
    let header_lbl: String = header_lbl_res.reg

    let body_lbl_res: GenResult = next_label(g)
    g = body_lbl_res.gen
    let body_lbl: String = body_lbl_res.reg

    let exit_lbl_res: GenResult = next_label(g)
    g = exit_lbl_res.gen
    let exit_lbl: String = exit_lbl_res.reg

    g = loop_push(g, header_lbl, exit_lbl)

    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    g.indent_level = saved_indent
    g = emit_raw(g, header_lbl + ":\n")
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "  br label %" + body_lbl + "\n")

    g.indent_level = saved_indent
    g = emit_raw(g, body_lbl + ":\n")
    g.indent_level = saved_indent + 1

    if body_idx >= 0 and body_idx < len(ast_nodes):
        let body_result: GenTypeResult = compile_expr_textual(g, body_idx, ast_nodes)
        g = body_result.gen

    g = emit_raw(g, "  br label %" + header_lbl + "\n")

    // Exit block
    g.indent_level = saved_indent
    g = emit_raw(g, exit_lbl + ":\n")
    g = loop_pop(g)
    g.indent_level = saved_indent + 1
    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0\n")
    g.indent_level = saved_indent

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ── compile_break_textual — branch to loop exit ──
// AST_STMT_BREAK layout: data[0]=value_expr_idx (-1 if none)

pub fn compile_break_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> LlvmGenerator:
    let break_lbl: String = loop_break_label(gen)
    if break_lbl != "":
        let mut g: LlvmGenerator = gen
        g = emit_raw(g, "  br label %" + break_lbl + "\n")
        return g
    // No enclosing loop — emit comment
    let mut g: LlvmGenerator = gen
    g = emit_raw(g, "  ; break outside loop\n")
    return g

// ── compile_continue_textual — branch to loop header ──

pub fn compile_continue_textual(gen: LlvmGenerator,
                                 node: AstNode,
                                 ast_nodes: Array<AstNode>) -> LlvmGenerator:
    let continue_lbl: String = loop_continue_label(gen)
    if continue_lbl != "":
        let mut g: LlvmGenerator = gen
        g = emit_raw(g, "  br label %" + continue_lbl + "\n")
        return g
    let mut g: LlvmGenerator = gen
    g = emit_raw(g, "  ; continue outside loop\n")
    return g

// ── compile_array_lit_textual — [a, b, c] → alloca + gep + store chain ──
// AST_EXPR_ARRAY layout: data[0]=element_count, data[1..N]=element expr indices

pub fn compile_array_lit_textual(gen: LlvmGenerator,
                                  node: AstNode,
                                  ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let elem_count: Int = if dlen > 0: ast_data_get(node, 0) else: 0

    let mut g: LlvmGenerator = gen

    // Allocate array
    let alloca_nr: GenResult = next_reg(g)
    g = alloca_nr.gen
    let alloca_reg: String = alloca_nr.reg
    g = emit_raw(g, "  " + alloca_reg + " = alloca [" + str(elem_count) + " x i64], align 8\n")

    // Store each element
    var ei: Int = 0
    while ei < elem_count:
        let elem_idx: Int = ast_data_get(node, 1 + ei)
        if elem_idx >= 0 and elem_idx < len(ast_nodes):
            let elem_result: GenTypeResult = compile_expr_textual(g, elem_idx, ast_nodes)
            g = elem_result.gen
            let gep_nr: GenResult = next_reg(g)
            g = gep_nr.gen
            g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds [" + str(elem_count) + " x i64], ptr " + alloca_reg + ", i32 0, i32 " + str(ei) + "\n")
            g = emit_raw(g, "  store " + elem_result.llvm_type + " " + elem_result.reg + ", ptr " + gep_nr.reg + ", align 8\n")
        ei = ei + 1

    return GenTypeResult { gen: g, reg: alloca_reg, llvm_type: "ptr" }

// ── compile_index_textual — arr[i] → GEP + load ──
// AST_EXPR_INDEX layout: data[0]=base_expr_idx, data[1]=index_expr_idx

pub fn compile_index_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let base_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let index_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    // Compile base (array/pointer)
    let base_result: GenTypeResult = compile_expr_textual(gen, base_idx, ast_nodes)
    let mut g: LlvmGenerator = base_result.gen
    let base_reg: String = base_result.reg
    let base_ty: String = base_result.llvm_type

    // Compile index
    let index_result: GenTypeResult = compile_expr_textual(g, index_idx, ast_nodes)
    g = index_result.gen
    let index_reg: String = index_result.reg

    // GEP
    let gep_nr: GenResult = next_reg(g)
    g = gep_nr.gen
    g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds i64, ptr " + base_reg + ", i64 " + index_reg + "\n")

    // Load
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load i64, ptr " + gep_nr.reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: "i64" }

// ── compile_and_textual — short-circuit and: a and b ──

pub fn compile_and_textual(gen: LlvmGenerator,
                            lhs_reg: String,
                            lhs_ty: String,
                            rhs_idx: Int,
                            ast_nodes: Array<AstNode>) -> GenTypeResult:
    let mut g: LlvmGenerator = gen
    let saved_indent: Int = g.indent_level

    // Convert lhs to i1 if needed
    var cond_reg: String = lhs_reg
    if lhs_ty != "i1":
        let cmp_nr: GenResult = next_reg(g)
        g = cmp_nr.gen
        g = emit_raw(g, "  " + cmp_nr.reg + " = icmp ne " + lhs_ty + " " + lhs_reg + ", 0\n")
        cond_reg = cmp_nr.reg

    let rhs_lbl_res: GenResult = next_label(g)
    g = rhs_lbl_res.gen
    let rhs_lbl: String = rhs_lbl_res.reg

    let skip_lbl_res: GenResult = next_label(g)
    g = skip_lbl_res.gen
    let skip_lbl: String = skip_lbl_res.reg

    let merge_lbl_res: GenResult = next_label(g)
    g = merge_lbl_res.gen
    let merge_lbl: String = merge_lbl_res.reg

    g = emit_raw(g, "  br i1 " + cond_reg + ", label %" + rhs_lbl + ", label %" + skip_lbl + "\n")

    // Evaluate rhs
    g.indent_level = saved_indent
    g = emit_raw(g, rhs_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let rhs_result: GenTypeResult = compile_expr_textual(g, rhs_idx, ast_nodes)
    g = rhs_result.gen
    let rhs_val: String = rhs_result.reg
    let rhs_ty: String = rhs_result.llvm_type
    // Convert rhs to i1
    var rhs_cond: String = rhs_val
    if rhs_ty != "i1":
        let c2_nr: GenResult = next_reg(g)
        g = c2_nr.gen
        g = emit_raw(g, "  " + c2_nr.reg + " = icmp ne " + rhs_ty + " " + rhs_val + ", 0\n")
        rhs_cond = c2_nr.reg
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Skip (lhs was false)
    g.indent_level = saved_indent
    g = emit_raw(g, skip_lbl + ":\n")
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Merge with phi
    g.indent_level = saved_indent
    g = emit_raw(g, merge_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let phi_nr: GenResult = next_reg(g)
    g = phi_nr.gen
    g = emit_raw(g, "  " + phi_nr.reg + " = phi i1 [ " + rhs_cond + ", %" + rhs_lbl + " ], [ false, %" + skip_lbl + " ]\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: phi_nr.reg, llvm_type: "i1" }

// ── compile_or_textual — short-circuit or: a or b ──

pub fn compile_or_textual(gen: LlvmGenerator,
                           lhs_reg: String,
                           lhs_ty: String,
                           rhs_idx: Int,
                           ast_nodes: Array<AstNode>) -> GenTypeResult:
    let mut g: LlvmGenerator = gen
    let saved_indent: Int = g.indent_level

    var cond_reg: String = lhs_reg
    if lhs_ty != "i1":
        let cmp_nr: GenResult = next_reg(g)
        g = cmp_nr.gen
        g = emit_raw(g, "  " + cmp_nr.reg + " = icmp ne " + lhs_ty + " " + lhs_reg + ", 0\n")
        cond_reg = cmp_nr.reg

    let skip_lbl_res: GenResult = next_label(g)
    g = skip_lbl_res.gen
    let skip_lbl: String = skip_lbl_res.reg

    let rhs_lbl_res: GenResult = next_label(g)
    g = rhs_lbl_res.gen
    let rhs_lbl: String = rhs_lbl_res.reg

    let merge_lbl_res: GenResult = next_label(g)
    g = merge_lbl_res.gen
    let merge_lbl: String = merge_lbl_res.reg

    // If lhs is true → skip to merge with true, else evaluate rhs
    g = emit_raw(g, "  br i1 " + cond_reg + ", label %" + skip_lbl + ", label %" + rhs_lbl + "\n")

    // Skip (lhs was true)
    g.indent_level = saved_indent
    g = emit_raw(g, skip_lbl + ":\n")
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Evaluate rhs
    g.indent_level = saved_indent
    g = emit_raw(g, rhs_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let rhs_result: GenTypeResult = compile_expr_textual(g, rhs_idx, ast_nodes)
    g = rhs_result.gen
    let rhs_val: String = rhs_result.reg
    let rhs_ty: String = rhs_result.llvm_type
    var rhs_cond: String = rhs_val
    if rhs_ty != "i1":
        let c2_nr: GenResult = next_reg(g)
        g = c2_nr.gen
        g = emit_raw(g, "  " + c2_nr.reg + " = icmp ne " + rhs_ty + " " + rhs_val + ", 0\n")
        rhs_cond = c2_nr.reg
    g.indent_level = saved_indent + 1
    g = emit_raw(g, "br label %" + merge_lbl + "\n")

    // Merge
    g.indent_level = saved_indent
    g = emit_raw(g, merge_lbl + ":\n")
    g.indent_level = saved_indent + 1
    let phi_nr: GenResult = next_reg(g)
    g = phi_nr.gen
    g = emit_raw(g, "  " + phi_nr.reg + " = phi i1 [ true, %" + skip_lbl + " ], [ " + rhs_cond + ", %" + rhs_lbl + " ]\n")

    g.indent_level = saved_indent
    return GenTypeResult { gen: g, reg: phi_nr.reg, llvm_type: "i1" }

// ── compile_method_call_textual — obj.method(args) → direct call to struct_N_method ──
// AST_EXPR_METHOD_CALL layout: data[0]=method_name_idx, data[1]=object_expr_idx, data[2..N]=arg expr indices

pub fn compile_method_call_textual(gen: LlvmGenerator,
                                    node: AstNode,
                                    ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let method_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let obj_idx: Int = if dlen > 1: ast_data_get(node, 1) else: -1

    let mut g: LlvmGenerator = gen

    // Compile object (self)
    var self_reg: String = "null"
    var self_ty: String = "ptr"
    if obj_idx >= 0 and obj_idx < len(ast_nodes):
        let obj_result: GenTypeResult = compile_expr_textual(g, obj_idx, ast_nodes)
        g = obj_result.gen
        self_reg = obj_result.reg
        self_ty = obj_result.llvm_type

    // Build method name
    let fn_name: String = "method_" + str(method_name_idx) + "_" + str(obj_idx)

    // Compile arguments (starting from data[2])
    var args_str: String = self_ty + " " + self_reg
    var ai: Int = 2
    while ai < dlen:
        let arg_idx: Int = ast_data_get(node, ai)
        if arg_idx >= 0 and arg_idx < len(ast_nodes):
            let arg_result: GenTypeResult = compile_expr_textual(g, arg_idx, ast_nodes)
            g = arg_result.gen
            args_str = args_str + ", " + arg_result.llvm_type + " " + arg_result.reg
        ai = ai + 1

    let nr: GenResult = next_reg(g)
    g = nr.gen
    g = emit_raw(g, "  " + nr.reg + " = call i64 @" + fn_name + "(" + args_str + ")\n")

    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ── compile_enum_variant_textual — Enum::Variant(payload) → alloca + tag store ──

pub fn compile_enum_variant_textual(gen: LlvmGenerator,
                                     node: AstNode,
                                     ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let enum_name_idx: Int = if dlen > 0: ast_data_get(node, 0) else: -1
    let variant_idx: Int = if dlen > 1: ast_data_get(node, 1) else: 0
    let payload_idx: Int = if dlen > 2: ast_data_get(node, 2) else: -1

    let enum_ty: String = "%enum_" + str(enum_name_idx)
    let mut g: LlvmGenerator = gen

    // Allocate enum
    let alloca_nr: GenResult = next_reg(g)
    g = alloca_nr.gen
    let alloca_reg: String = alloca_nr.reg
    g = emit_raw(g, "  " + alloca_reg + " = alloca " + enum_ty + ", align 8\n")

    // Store tag (field 0)
    let gep_tag_nr: GenResult = next_reg(g)
    g = gep_tag_nr.gen
    g = emit_raw(g, "  " + gep_tag_nr.reg + " = getelementptr inbounds " + enum_ty + ", ptr " + alloca_reg + ", i32 0, i32 0\n")
    g = emit_raw(g, "  store i64 " + str(variant_idx) + ", ptr " + gep_tag_nr.reg + ", align 8\n")

    // Store payload if present
    if payload_idx >= 0 and payload_idx < len(ast_nodes):
        let payload_result: GenTypeResult = compile_expr_textual(g, payload_idx, ast_nodes)
        g = payload_result.gen
        let gep_pay_nr: GenResult = next_reg(g)
        g = gep_pay_nr.gen
        g = emit_raw(g, "  " + gep_pay_nr.reg + " = getelementptr inbounds " + enum_ty + ", ptr " + alloca_reg + ", i32 0, i32 1\n")
        g = emit_raw(g, "  store " + payload_result.llvm_type + " " + payload_result.reg + ", ptr " + gep_pay_nr.reg + ", align 8\n")

    // Load enum value
    let load_nr: GenResult = next_reg(g)
    g = load_nr.gen
    g = emit_raw(g, "  " + load_nr.reg + " = load " + enum_ty + ", ptr " + alloca_reg + ", align 8\n")

    return GenTypeResult { gen: g, reg: load_nr.reg, llvm_type: enum_ty }

// ── compile_lambda_textual — stub: function pointer placeholder ──

pub fn compile_lambda_textual(gen: LlvmGenerator,
                               node: AstNode,
                               ast_nodes: Array<AstNode>) -> GenTypeResult:
    let mut g: LlvmGenerator = gen
    let nr: GenResult = next_reg(g)
    g = nr.gen
    // Stub: return null function pointer
    g = emit_raw(g, "  " + nr.reg + " = inttoptr i64 0 to ptr  ; lambda stub (null fn ptr)\n")
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "ptr" }

// ── compile_spawn_textual — actor spawn stub ──

pub fn compile_spawn_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let mut g: LlvmGenerator = gen
    let nr: GenResult = next_reg(g)
    g = nr.gen
    // Stub: return actor ID 0
    g = emit_raw(g, "  " + nr.reg + " = add i64 0, 0  ; spawn stub\n")
    return GenTypeResult { gen: g, reg: nr.reg, llvm_type: "i64" }

// ── compile_tuple_textual — tuple literal → alloca struct ──

pub fn compile_tuple_textual(gen: LlvmGenerator,
                              node: AstNode,
                              ast_nodes: Array<AstNode>) -> GenTypeResult:
    let dlen: Int = ast_data_len(node)
    let elem_count: Int = if dlen > 0: ast_data_get(node, 0) else: 0

    let mut g: LlvmGenerator = gen
    let alloca_nr: GenResult = next_reg(g)
    g = alloca_nr.gen
    let alloca_reg: String = alloca_nr.reg

    if elem_count == 0:
        g = emit_raw(g, "  " + alloca_reg + " = alloca {}, align 8\n")
        return GenTypeResult { gen: g, reg: alloca_reg, llvm_type: "{}" }

    g = emit_raw(g, "  " + alloca_reg + " = alloca [" + str(elem_count) + " x i64], align 8\n")

    var ei: Int = 0
    while ei < elem_count:
        let elem_idx: Int = ast_data_get(node, 1 + ei)
        if elem_idx >= 0 and elem_idx < len(ast_nodes):
            let elem_result: GenTypeResult = compile_expr_textual(g, elem_idx, ast_nodes)
            g = elem_result.gen
            let gep_nr: GenResult = next_reg(g)
            g = gep_nr.gen
            g = emit_raw(g, "  " + gep_nr.reg + " = getelementptr inbounds [" + str(elem_count) + " x i64], ptr " + alloca_reg + ", i32 0, i32 " + str(ei) + "\n")
            g = emit_raw(g, "  store " + elem_result.llvm_type + " " + elem_result.reg + ", ptr " + gep_nr.reg + ", align 8\n")
        ei = ei + 1

    return GenTypeResult { gen: g, reg: alloca_reg, llvm_type: "ptr" }

// ═══════════════════════════════════════════════════════════════════
// PATH B: LLVM-C API Codegen (in-memory IR construction)
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_llvm_c(program: MonomorphizedProgram) -> LLVMModuleRef with Unsafe:
    let ctx: LLVMContextRef = llvm_context_create()
    let mod_ref: LLVMModuleRef = llvm_module_create_with_name("kainc_module", ctx)

    let triple: String = target_triple_for_platform()
    llvm_set_target(mod_ref, triple)
    llvm_set_data_layout(mod_ref, data_layout_string())

    let builder: LLVMBuilderRef = llvm_builder_create(ctx)

    // Compile each function (Path B: stub — delegates to Path A for body)
    var i: Int = 0
    while i < len(program.items):
        let item: TypedItem = program.items[i]
        if item.kind == AST_ITEM_FUNCTION:
            let ret_ty: LLVMTypeRef = llvm_int64_type(ctx)
            let fn_type: LLVMTypeRef = llvm_function_type(ret_ty, [], false)
            let fn_val: LLVMValueRef = llvm_add_function(mod_ref, item.name, fn_type)
            let bb: LLVMBasicBlockRef = llvm_append_basic_block_in_context(ctx, fn_val, "entry")
            llvm_position_at_end(builder, bb)
            let zero_val: LLVMValueRef = llvm_const_int(ret_ty, 0, false)
            llvm_build_ret(builder, zero_val)
        i = i + 1

    let is_valid: Bool = llvm_verify_module(mod_ref, LLVM_RETURN_STATUS_ACTION)
    llvm_builder_dispose(builder)

    return mod_ref

// ═══════════════════════════════════════════════════════════════════
// codegen_compile — main entry: dispatches to Path A or Path B
// ═══════════════════════════════════════════════════════════════════

pub fn codegen_compile(program: MonomorphizedProgram,
                        target: String,
                        output_path: String) -> String with IO:
    let triple: String = target_triple_for_platform()

    // Path A: textual .ll emission (always available)
    let llvm_text: String = codegen_textual(program, triple, false)

    if output_path != "":
        cg_write_text(output_path, llvm_text)
        println("[codegen] Wrote " + str(len(llvm_text)) + " bytes to " + output_path)

    return llvm_text

// ═══════════════════════════════════════════════════════════════════
// Utility: fs_write_text (thin wrapper)
// ═══════════════════════════════════════════════════════════════════

pub fn cg_write_text(path: String, content: String) with IO:
    let msg: String = "[codegen] write to " + path + " (" + str(len(content)) + " bytes)"
    println(msg)

// ═══════════════════════════════════════════════════════════════════
// END STREAM GOLF — codegen.kn
// ═══════════════════════════════════════════════════════════════════

